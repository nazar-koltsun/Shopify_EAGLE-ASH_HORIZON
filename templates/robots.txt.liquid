# Eagle & Ash (eagleandash.com). This website does not take orders: there is no cart or checkout here.
# Every product is sold on Amazon.com through the "Shop on Amazon" link on each product page.
# Information for AI agents: https://eagleandash.com/agents.md
{% for group in robots.default_groups %}
  {{- group.user_agent }}

  {%- for rule in group.rules -%}
    {{ rule }}
  {%- endfor -%}

  {%- if group.sitemap != blank -%}
    {{ group.sitemap }}
  {%- endif -%}
{% endfor %}
