{%- doc -%}
  Link to the product's sister versions, e.g. Zip ↔ Flex, or the other bath bomb scents. Reads the product
  field custom.other_styles (list of products) and the optional lead-in custom.other_styles_text
  (e.g. "Prefer one-hand access?"). The link text is the part of each title after the last "–", without
  brackets ("Leather Golf Tee Pouch – Flex" → "Flex"). Hidden when the list is empty.
{%- enddoc -%}
{%- liquid
  assign ea_others = closest.product.metafields.custom.other_styles.value
  assign ea_lead = closest.product.metafields.custom.other_styles_text.value | default: block.settings.label
  assign ea_own_swatch = closest.product.metafields.custom.style_swatch.value
-%}
{%- liquid
  # Eagle & Ash, 30 Oct 2026 (Anu: "add the duo pack in the variation list, and also the two single ones for the duo ...
  # just like bath bombs"): when the product or one of its other versions has a Style-row swatch (custom.style_row_swatch,
  # e.g. the Duo Pack), one row shows every style of the family: first each variant of the products with several styles
  # (Wood Top, Stone Top: links to that variant), then the single products (Duo Pack). The current one is framed.
  # On a page whose product has several styles this row replaces the theme's own variant picker.
  assign ea_row = false
  if ea_others != blank
    if closest.product.metafields.custom.style_row_swatch.value != blank
      assign ea_row = true
    endif
    for other in ea_others
      if other.metafields.custom.style_row_swatch.value != blank
        assign ea_row = true
      endif
    endfor
  endif
  assign ea_row_label = 'Style'
  if closest.product.variants.size > 1
    assign ea_row_label = closest.product.options.first
  else
    for other in ea_others
      if other.variants.size > 1
        assign ea_row_label = other.options.first
        break
      endif
    endfor
  endif
  assign ea_selected = closest.product.selected_or_first_available_variant.id
-%}
{%- if ea_row -%}
  <div class="ea-style-swatches ea-style-swatches--row">
    <p class="ea-style-swatches__label">{{ ea_row_label | escape }}</p>
    <ul class="ea-style-swatches__list" role="list">
      {%- if closest.product.variants.size > 1 -%}
        {%- for v in closest.product.variants -%}
          {%- liquid
            assign ea_is = false
            if v.id == ea_selected
              assign ea_is = true
            endif
          -%}
          {%- render 'ea-style-swatch', item: closest.product, current: ea_is, url: v.url, name: v.title, image: v.metafields.custom.swatch_image.value -%}
        {%- endfor -%}
      {%- endif -%}
      {%- for other in ea_others -%}
        {%- if other.id == closest.product.id or other.variants.size < 2 -%}{%- continue -%}{%- endif -%}
        {%- for v in other.variants -%}
          {%- render 'ea-style-swatch', item: other, current: false, url: v.url, name: v.title, image: v.metafields.custom.swatch_image.value -%}
        {%- endfor -%}
      {%- endfor -%}
      {%- if closest.product.variants.size < 2 -%}
        {%- render 'ea-style-swatch', item: closest.product, current: true, image: closest.product.metafields.custom.style_row_swatch.value -%}
      {%- endif -%}
      {%- for other in ea_others -%}
        {%- if other.id == closest.product.id or other.variants.size > 1 -%}{%- continue -%}{%- endif -%}
        {%- render 'ea-style-swatch', item: other, current: false, image: other.metafields.custom.style_row_swatch.value -%}
      {%- endfor -%}
    </ul>
  </div>
  {%- if closest.product.variants.size > 1 -%}
    <style>
      .product-details:has(.ea-style-swatches--row) variant-picker { display: none; }
    </style>
  {%- endif -%}
{%- elsif ea_others != blank -%}
  {%- if ea_own_swatch != blank -%}
    {%- comment -%}
      Eagle & Ash, Oct 2026: sister products shown as swatches (the bath bomb scents). Each product has its own page;
      the swatch row makes them look and work like variations. List order = the "Other versions" field; the current
      product is framed (added at the start if the field does not contain it). Name = title part after the last "–".
    {%- endcomment -%}
    {%- liquid
      assign ea_has_self = false
      for other in ea_others
        if other.id == closest.product.id
          assign ea_has_self = true
        endif
      endfor
    -%}
    <div class="ea-style-swatches">
      <p class="ea-style-swatches__label">{{ block.settings.swatch_label | escape }}</p>
      <ul class="ea-style-swatches__list" role="list">
        {%- unless ea_has_self -%}
          {%- render 'ea-style-swatch', item: closest.product, current: true -%}
        {%- endunless -%}
        {%- for other in ea_others -%}
          {%- if other.id == closest.product.id -%}
            {%- render 'ea-style-swatch', item: other, current: true -%}
          {%- else -%}
            {%- render 'ea-style-swatch', item: other, current: false -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- else -%}
    <p class="ea-other-styles">
      <span class="ea-other-styles__lead">{{ ea_lead | escape }}</span>
      {%- assign ea_first = true -%}
      {%- for other in ea_others -%}
        {%- if other.id == closest.product.id -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign ea_name = other.title
          if other.title contains '–'
            assign ea_name = other.title | split: '–' | last
          endif
          assign ea_name = ea_name | split: '(' | first | strip
        -%}
        {% if ea_first %} {% else %} · {% endif %}<a href="{{ other.url }}">{{ block.settings.link_prefix | escape }}{{ ea_name | escape }} →</a>
        {%- assign ea_first = false -%}
      {%- endfor -%}
    </p>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .ea-other-styles {
    margin: 0;
    font-size: 0.875rem;
  }

  .ea-other-styles a {
    color: inherit;
    font-weight: 500;
    text-underline-offset: 3px;
  }

  .ea-other-styles a:hover {
    color: #fd5000;
  }

  /* Swatch row for sister products (bath bomb scents): same size and frame as the colour swatches. */
  .ea-style-swatches__label {
    margin: 0 0 8px;
    font-size: 0.875rem;
  }

  .ea-style-swatches__list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ea-style-swatch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .ea-style-swatch__img {
    display: block;
    width: 60px;
    height: 60px;
    border-radius: 8px;
    object-fit: cover;
  }

  a.ea-style-swatch:hover .ea-style-swatch__img {
    outline: var(--focus-outline-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-35-55));
    outline-offset: var(--focus-outline-offset);
  }

  .ea-style-swatch--current .ea-style-swatch__img {
    outline: 2px solid #001e26;
    outline-offset: 2px;
  }

  .ea-style-swatch__name {
    max-width: 76px;
    font-size: 0.75rem;
    line-height: 1.2;
    text-align: center;
  }

  .ea-style-swatch--current .ea-style-swatch__name {
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Other versions link",
  "settings": [
    { "type": "paragraph", "content": "Shows the product fields \"Other versions\" (custom.other_styles) and \"Other versions: lead-in\" (custom.other_styles_text)." },
    { "type": "text", "id": "label", "label": "Lead-in when the product has none", "default": "Also available:" },
    { "type": "text", "id": "link_prefix", "label": "Text before each name", "default": "See the " },
    { "type": "text", "id": "swatch_label", "label": "Label above the swatches (when the product has a swatch image)", "default": "Scent" }
  ],
  "presets": [{ "name": "Other versions link" }]
}
{% endschema %}
