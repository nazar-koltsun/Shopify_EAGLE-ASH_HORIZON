

{%- assign block_settings = block.settings -%}
{%- liquid
  # Eagle & Ash, Oct 2026: optional offer text with an end date. Until that date (store time zone)
  # the offer text replaces the normal text; afterwards the normal text comes back by itself.
  assign ea_text = block_settings.text
  if block_settings.offer_text != blank and block_settings.offer_until != blank
    assign ea_today = 'now' | date: '%Y%m%d' | plus: 0
    assign ea_until = block_settings.offer_until | remove: '-' | plus: 0
    if ea_today <= ea_until
      assign ea_text = block_settings.offer_text
      assign ea_phone_text = block_settings.offer_text_phone
    endif
  endif
-%}
{%- assign plain_text = ea_text | strip_newlines | strip_html | strip -%}
{%- assign block_index = section.blocks | find_index: 'id', block.id -%}

{%- unless plain_text == '' -%}
  <slideshow-slide
    ref="slides[]"
    class="announcement-bar__slide"
    {{ block.shopify_attributes }}
    aria-hidden="{% if block_index == 0 %}false{% else %}true{% endif %}"
  >
    <p class="announcement-bar__text">
      {%- if ea_phone_text != blank -%}
        <span class="announcement-bar__text-wide">{{ ea_text }}</span>
        <span class="announcement-bar__text-phone">{{ ea_phone_text }}</span>
      {%- else -%}
        {{ ea_text }}
      {%- endif -%}
    </p>

    {% if block_settings.link != blank %}
      <a
        class="announcement-bar__link"
        href="{{ block_settings.link }}"
      >
        <span class="visually-hidden">
          {{ ea_text | strip_html }}
        </span>
      </a>
    {% endif %}
  </slideshow-slide>
{%- endunless -%}

{% stylesheet %}
  /* Eagle & Ash, 1 Nov 2026: shorter offer text on phones, so the banner stays one line */
  .announcement-bar__text-phone { display: none; }

  @media screen and (max-width: 749px) {
    .announcement-bar__text-wide { display: none; }
    .announcement-bar__text-phone { display: inline; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "offer_text",
      "label": "Offer text (optional, replaces the text until the end date)"
    },
    {
      "type": "inline_richtext",
      "id": "offer_text_phone",
      "label": "Offer text on phones (optional, shorter)",
      "info": "Shown instead of the offer text on screens below 750 px, so the banner stays one line."
    },
    {
      "type": "text",
      "id": "offer_until",
      "label": "Offer end date (YYYY-MM-DD)",
      "info": "From the next day the normal text below shows again."
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.shop_our_latest_arrivals"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement",
      "settings": {}
    }
  ]
}
{% endschema %}
