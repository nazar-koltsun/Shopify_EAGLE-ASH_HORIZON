{%- doc -%}
  Eagle & Ash, Oct 2026: the swatch row under every product card (Shop page and "Complete the set"), the same look
  for all products. Drawn without Horizon's overflow measuring, which sometimes showed "+5" instead of the colours.
  - Sister pages shown as one card (the bath bomb scents): custom.style_swatch + custom.other_styles (all scents in a
    fixed order, the card's own one included). Each swatch shows that scent's main photo, name and price on the card
    and points the card's links to its page (Anu, 28 Oct 2026: a swatch should not open another page).
  - Otherwise the values of the first option: the variant's custom.swatch_image, else the value's own swatch (colour
    entries); for the option "Length" (tees) the length as text. A swatch whose variant has its own photo is a button:
    it shows that photo on the card and sets the card's price and links to that variant (Anu, 27 Oct 2026); the
    photos are already in the card, hidden. A variant without its own photo opens the product page with that variant
    selected. A variant without an Amazon link is "coming soon" and shown pale; it is a button too, and its click
    covers the card photo with a panel in the swatch colour that says "Coming soon" (Anu, 27 Oct 2026).
  The card's own scent or variant is framed. After the swatches: custom.card_note, or "N scents" for sister pages.
  A product without swatches shows only its card_note (Duo Pack: "Wood Top + Stone Top"), or nothing.

  @param {object} product - The card's product.
{%- enddoc -%}
{%- liquid
  assign ea_own = product.metafields.custom.style_swatch.value
  assign ea_sisters = product.metafields.custom.other_styles.value
  assign ea_note = product.metafields.custom.card_note.value
  assign ea_current = product.selected_or_first_available_variant.id

  capture ea_items
    if ea_own != blank and ea_sisters != blank
      for item in ea_sisters
        assign ea_img = item.metafields.custom.style_swatch.value
        assign ea_name = item.title
        if item.title contains '–'
          assign ea_name = item.title | split: '–' | last
        endif
        assign ea_name = ea_name | split: '(' | first | strip
        assign ea_class = 'ea-swatch-row__link'
        assign ea_is_current = false
        if item.id == product.id
          assign ea_class = ea_class | append: ' ea-swatch-row__link--current'
          assign ea_is_current = true
        endif
        render 'ea-card-swatch-row-item', url: item.url, title: ea_name, image: ea_img, class: ea_class, current: ea_is_current, pick: true, price: item.price, card_image: item.featured_image, card_title: item.title
      endfor
      if ea_note == blank
        assign ea_note = ea_sisters.size | append: ' scents'
      endif
    elsif product.has_only_default_variant == false
      assign ea_length = false
      if product.options.first == 'Length'
        assign ea_length = true
      endif
      for value in product.options_with_values.first.values
        assign ea_variant = value.variant
        if ea_variant == blank
          continue
        endif
        assign ea_text = blank
        assign ea_img = ea_variant.metafields.custom.swatch_image.value
        if ea_img == blank
          assign ea_img = value.swatch.image
        endif
        if ea_length
          # Tee lengths as text, e.g. 3 1/4" (83 mm) -> 3¼″: the swatch pictures are blurry at 26px.
          assign ea_text = value.name | split: ' (' | first | replace: ' 1/4', '¼' | replace: ' 3/4', '¾' | replace: ' 1/2', '½' | replace: '"', '″'
          assign ea_img = blank
        elsif ea_img == blank and value.swatch.color == blank
          continue
        endif
        assign ea_title = value.name
        assign ea_class = 'ea-swatch-row__link'
        assign ea_soon = false
        if ea_variant.metafields.custom.amazon_url.value == blank
          assign ea_title = value.name | append: ': coming soon'
          assign ea_class = ea_class | append: ' ea-swatch-row__link--soon'
          assign ea_soon = true
        endif
        assign ea_is_current = false
        if ea_variant.id == ea_current
          assign ea_class = ea_class | append: ' ea-swatch-row__link--current'
          assign ea_is_current = true
        endif
        assign ea_pick = false
        if ea_variant.featured_media != blank or ea_soon
          assign ea_pick = true
        endif
        render 'ea-card-swatch-row-item', url: ea_variant.url, title: ea_title, image: ea_img, color: value.swatch.color, text: ea_text, class: ea_class, current: ea_is_current, pick: ea_pick, media_id: ea_variant.featured_media.id, price: ea_variant.price, soon: ea_soon, name: value.name
      endfor
    endif
  endcapture
-%}
{%- if ea_items != blank or ea_note != blank -%}
  <div class="ea-swatch-row">
    {%- if ea_items != blank -%}
      <ul class="ea-swatch-row__list" role="list">
        {{- ea_items -}}
      </ul>
    {%- endif -%}
    {%- if ea_note != blank -%}
      <p class="ea-swatch-row__note">{{ ea_note | escape }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  /* 15px: the distance from the price that the colour swatches had */
  .ea-swatch-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 8px 12px;
    margin: 15px 0 0;
    /* room for the frame of the selected swatch (2px + 2px gap), which the Shop card would otherwise cut off
       on the left and at the bottom; the frame's left edge then lines up with the product name */
    padding: 0 0 4px 4px;
  }

  .ea-swatch-row__list {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Above the card's own full-card link, so each swatch can be clicked on its own. */
  .ea-swatch-row__link {
    position: relative;
    z-index: 2;
    display: block;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    overflow: hidden;
    background: #fff;
  }

  /* Thin edge on top of the image, so swatches drawn on white still read as a square. */
  .ea-swatch-row__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(0 30 38 / 0.18);
    pointer-events: none;
  }

  button.ea-swatch-row__link {
    padding: 0;
    border: 0;
    font: inherit;
    cursor: pointer;
  }

  .ea-swatch-row__link img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ea-swatch-row__text {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: #001e26;
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .ea-swatch-row__link--soon {
    opacity: 0.45;
  }

  .ea-swatch-row__link:hover,
  .ea-swatch-row__link--current {
    outline: 2px solid #001e26;
    outline-offset: 2px;
  }

  /* "Coming soon" panel over the card photo, after a click on a colour that has no photo yet (made by the script below). */
  .card-gallery:has(> .ea-card-soon) {
    position: relative;
  }

  .ea-card-soon {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #f7f8f8;
    color: #001e26;
    text-align: center;
    pointer-events: none;
  }

  .ea-card-soon--badge {
    inset: auto 0 0;
    padding: 10px;
    background: rgb(255 255 255 / 0.9);
  }

  .ea-card-soon__name {
    font-size: 1rem;
  }

  .ea-card-soon__text {
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-weight: 400;
  }

  /* same look as the earlier "3 styles" line; 26px tall, so a note without swatches (Duo Pack) sits on the same line */
  .ea-swatch-row__note {
    display: flex;
    align-items: flex-end;
    min-height: 26px;
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
  }
{% endstylesheet %}

{% javascript %}
  // A swatch button (.ea-swatch-row__pick) shows its variant's photo on the card, the same way Horizon's
  // #updateVariantImages does, and points the card's price and links to that variant.
  // Listens on the window in the capture phase, before Horizon's product card, which would otherwise write the card's
  // position into the address for a click on a link inside the card.
  window.addEventListener('click', (event) => {
    const pick = event.target instanceof Element ? event.target.closest('.ea-swatch-row__pick') : null;
    const card = pick?.closest('product-card');
    if (!pick || !card) return;
    // A scent swatch is a link to its page (for search engines): a plain click stays on the card,
    // Ctrl/Cmd-click, Shift-click or the middle button still open the page.
    if (pick.tagName === 'A') {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
      event.preventDefault();
      event.stopPropagation();
    }

    const { mediaId, url, price, soon, color, imageSrc, imageSrcset, imageAlt, cardTitle } = pick.dataset;
    const slideshow = card.querySelector('slideshow-component');
    if (slideshow && mediaId) {
      for (const slide of slideshow.querySelectorAll('slideshow-slide[variant-image]')) {
        slide.hidden = slide.getAttribute('slide-id') !== mediaId;
      }
      slideshow.select({ id: mediaId }, undefined, { animate: false });
    }

    // A sister page (bath bomb scent) is another product: its main photo takes the place of the card's first photo,
    // and its name the card's title.
    if (imageSrc) {
      const first = card.querySelector('slideshow-slide');
      const image = first?.querySelector('img') ?? card.querySelector('.card-gallery img');
      if (image) {
        image.srcset = imageSrcset || '';
        image.src = imageSrc;
        image.alt = imageAlt || '';
      }
      const firstId = first?.getAttribute('slide-id');
      if (slideshow && firstId) slideshow.select({ id: firstId }, undefined, { animate: false });
    }
    const titleElement = card.querySelector('[ref="productTitleLink"] p');
    if (titleElement && cardTitle) titleElement.textContent = cardTitle;

    // A "coming soon" colour has no photo yet: a panel in its swatch colour covers the card photo instead.
    card.querySelector('.ea-card-soon')?.remove();
    const gallery = card.querySelector('.card-gallery');
    if (soon !== undefined && gallery) {
      const panel = document.createElement('div');
      panel.className = mediaId ? 'ea-card-soon ea-card-soon--badge' : 'ea-card-soon';
      if (!mediaId && color) panel.style.background = color;
      const name = document.createElement('span');
      name.className = 'ea-card-soon__name';
      name.textContent = soon;
      const text = document.createElement('strong');
      text.className = 'ea-card-soon__text';
      text.textContent = 'Coming soon';
      panel.append(name, text);
      gallery.append(panel);
    }

    for (const link of card.querySelectorAll('[ref="productCardLink"], [ref="cardGalleryLink"], [ref="productTitleLink"]')) {
      link.setAttribute('href', url);
    }
    const priceElement = card.querySelector('product-price .price');
    if (priceElement && price) priceElement.textContent = price;

    for (const other of card.querySelectorAll('.ea-swatch-row__pick')) {
      other.classList.toggle('ea-swatch-row__link--current', other === pick);
      other.setAttribute('aria-pressed', String(other === pick));
    }
    card.setAttribute('data-ea-picked', '');
  }, true);

  // Horizon shows the card's next photo while the mouse is over it. Its next photo belongs to the first colour or
  // length, so after a swatch click the card keeps the chosen photo instead. Horizon listens on the document
  // (assets/component.js), so this listener sits on the window, which the event reaches first.
  for (const type of ['pointerenter', 'pointerleave']) {
    window.addEventListener(
      type,
      (event) => {
        const target = event.target;
        if (target instanceof Element && target.matches('.card-gallery') && target.closest('product-card[data-ea-picked]')) {
          event.stopPropagation();
        }
      },
      true
    );
  }

  // The scent links carry role="button": the Space key works on them as on a button.
  document.addEventListener('keydown', (event) => {
    const pick = event.target instanceof Element ? event.target.closest('a.ea-swatch-row__pick') : null;
    if (!pick || event.key !== ' ') return;
    event.preventDefault();
    pick.click();
  });

  // Start loading a swatch's photo when the pointer reaches the swatch, so it is there by the click.
  document.addEventListener('pointerover', (event) => {
    const pick = event.target instanceof Element ? event.target.closest('.ea-swatch-row__pick') : null;
    const image = pick?.closest('product-card')?.querySelector(`slideshow-slide[slide-id="${pick.dataset.mediaId}"] img`);
    if (image) image.loading = 'eager';
  });
{% endjavascript %}
