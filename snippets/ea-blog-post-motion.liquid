{%- comment -%}
  Picture reveal on blog posts (Anu, 11 Nov 2026: "like lashweb.eu"). Measured on lashweb.eu: when a picture comes
  into view it zooms from 1.3 to 1.0 in about 1.5 s with a slowing curve, once, not tied to the scroll speed.
  Same here: 1.3 to 1.0 in 1.5 s, the same slowing curve (ease-out, matched to their measured values). A small script only marks pictures that came into
  view; nothing is loaded or sent. No movement for visitors whose device asks for less motion, and without the
  script the pictures simply stand still. Rendered at the END of the section, so the pictures already exist.
{%- endcomment -%}
<style>
  .ea-blog-post.ea-motion .blog-post-featured-image,
  .ea-blog-post.ea-motion .blog-post-content p:has(> img) { overflow: clip; }
  .ea-blog-post.ea-motion .ea-zoom {
    transform: scale(1.3);
    transition: transform 1.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .ea-blog-post.ea-motion .ea-zoom.is-in { transform: scale(1); }
</style>
<script>
  (function () {
    if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var roots = document.querySelectorAll('.ea-blog-post');
    if (!roots.length) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.2 });
    roots.forEach(function (root) {
      root.classList.add('ea-motion');
      root.querySelectorAll('.blog-post-featured-image__image, .blog-post-content img').forEach(function (img) {
        img.classList.add('ea-zoom');
        io.observe(img);
      });
    });
  })();
</script>
