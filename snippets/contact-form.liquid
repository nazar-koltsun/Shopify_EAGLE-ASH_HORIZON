{%- liquid
  assign form_id = form_id | default: 'ContactForm'
  assign submit_label = submit_label | default: 'SEND'
  assign name_id = form_id | append: '-name'
  assign email_id = form_id | append: '-email'
  assign company_id = form_id | append: '-company'
  assign body_id = form_id | append: '-body'
-%}

{%- form 'contact', id: form_id, class: 'contact-form' -%}
  <input
    name="contact[id]"
    type="hidden"
    value="{{ form_id }}">

  {%- if form.errors and form.id == form_id -%}
    <div
      class="contact-form__error"
      tabindex="-1"
      autofocus>
      {{- 'icon-error.svg' | inline_asset_content -}}

      {{- form.errors.translated_fields.email | capitalize }}
      {{ form.errors.messages.email -}}
    </div>
  {%- endif -%}

  {%- if form.posted_successfully? -%}
    <div
      class="contact-form__success"
      role="status"
      tabindex="-1"
      autofocus>
      <span class="contact-form__success-icon" aria-hidden="true">
        {{- 'icon-checkmark.svg' | inline_asset_content -}}
      </span>
      <p class="contact-form__success-text">
        {{- 'blocks.contact_form.post_success' | t -}}
      </p>
    </div>
  {%- endif -%}

  <div class="contact-form__field">
    <input
      type="text"
      id="{{ name_id }}"
      class="contact-form__input"
      autocomplete="name"
      name="contact[name]"
      value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
      required
      aria-required="true"
      placeholder=" ">
    <label class="contact-form__field-label" for="{{ name_id }}">
      {{- 'blocks.contact_form.name' | t -}}
    </label>
  </div>

  <div class="contact-form__field">
    <input
      type="email"
      id="{{ email_id }}"
      class="contact-form__input"
      autocomplete="email"
      name="contact[email]"
      spellcheck="false"
      autocapitalize="off"
      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
      required
      aria-required="true"
      {% if form.errors contains 'email' and form.id == form_id %}
        aria-invalid="true"
        aria-describedby="{{ email_id }}-error"
      {% endif %}
      placeholder=" ">
    <label class="contact-form__field-label" for="{{ email_id }}">
      {{- 'blocks.contact_form.email' | t -}}
    </label>
  </div>

  <div class="contact-form__field">
    <input
      type="text"
      id="{{ company_id }}"
      class="contact-form__input"
      autocomplete="organization"
      name="contact[company]"
      value="{% if form.company %}{{ form.company }}{% endif %}"
      placeholder=" ">
    <label class="contact-form__field-label" for="{{ company_id }}">
      {{- 'blocks.contact_form.company' | t -}}
    </label>
  </div>

  <div class="contact-form__field contact-form__field--message">
    <textarea
      rows="6"
      id="{{ body_id }}"
      class="contact-form__input contact-form__input--textarea"
      name="contact[body]"
      required
      aria-required="true"
      placeholder=" ">{{- form.body -}}</textarea>
    <label class="contact-form__field-label" for="{{ body_id }}">
      Message
    </label>
  </div>

  <button type="submit" class="contact-form__submit">
    {{- submit_label | escape -}}
  </button>
{%- endform -%}

{% stylesheet %}
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contact-form__field {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-block-start: 20px;
  }

  .contact-form__field-label {
    position: absolute;
    top: 20px;
    left: 0;
    margin: 0;
    font-family: 'Lora', serif;
    font-weight: 500;
    font-size: 16px;
    color: #000000;
    text-transform: uppercase;
    pointer-events: none;
    transform-origin: left top;
    transition:
      top 0.2s ease,
      font-size 0.2s ease,
      letter-spacing 0.2s ease,
      transform 0.2s ease;

    @media screen and (max-width: 749px) {
      font-size: 15px;
    }
  }

  .contact-form__input:focus + .contact-form__field-label,
  .contact-form__input:not(:placeholder-shown) + .contact-form__field-label,
  .contact-form__input:-webkit-autofill + .contact-form__field-label {
    top: 0;
    font-size: 12px;
    letter-spacing: 0.08em;
    pointer-events: auto;
  }

  .contact-form__field .contact-form__input {
    width: 100%;
    margin: 0;
    padding: 0 0 4px;
    font-family: 'Lora', serif;
    font-size: 16px;
    color: #000000;
    background: transparent;
    border: none;
    border-bottom: 1px solid #000000;
    border-radius: 0;
    outline: none;
    box-shadow: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .contact-form__input--textarea {
    resize: vertical;
    height: 140px;
    padding-block-end: 10px;
  }

  .contact-form__submit {
    align-self: flex-start;
    margin: 0;
    margin-block-start: 8px;
    padding: 0;
    font-family: 'Lora', serif;
    font-weight: 500;
    font-size: 16px;
    color: #000000;
    background: none;
    border: none;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .contact-form__submit:hover {
    color: var(--ash-amber-orange, #fe5000);
  }

  .contact-form__error,
  .contact-form__success {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-block-end: 16px;
    padding: 12px 14px;
    font-family: 'Lora', serif;
    font-size: 14px;
    line-height: 1.4;
    color: var(--deepest-brand-blue, #07272d);
    background-color: #f5f7f7;

    @media screen and (max-width: 749px) {
      margin-block-start: 8px;
      margin-block-end: 0;
    }
  }

  .contact-form__success-icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-block-start: 1px;
  }

  .contact-form__success-icon svg {
    width: 100%;
    height: 100%;
  }

  .contact-form__success-text {
    margin: 0;
  }
{% endstylesheet %}
