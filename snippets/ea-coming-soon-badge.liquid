{%- doc -%}
  Eagle & Ash, 29 Oct 2026: the badge on a coming-soon product page (template product.coming-soon), from the product field
  custom.coming_soon (e.g. "Coming soon · Nov 2026"); "Coming soon" when the field is empty.

  @param {object} product - The product.
{%- enddoc -%}
<p class="ea-coming-soon-badge">{{ product.metafields.custom.coming_soon.value | default: 'Coming soon' | escape }}</p>

{% stylesheet %}
  .ea-coming-soon-badge {
    align-self: flex-start;
    margin: 12px 0 0; /* Anu, 31 Oct 2026: a little more space under the title (was 4 px) */
    padding: 5px 10px;
    border-radius: 4px;
    background: #001e26;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }

  /* Horizon sets margin-block-start: 0 on a paragraph that comes first in its box, and the badge is one */
  p.ea-coming-soon-badge:first-child {
    margin-block-start: 12px;
  }
{% endstylesheet %}
