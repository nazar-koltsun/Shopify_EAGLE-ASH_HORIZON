{%- doc -%}
  One swatch in snippets/ea-card-swatch-row.liquid.

  @param {string} url - Page the swatch opens (as a button: the address the card's links get).
  @param {string} title - Name for the tooltip and screen readers (e.g. "Wood Top", "Pink: coming soon").
  @param {object} [image] - Swatch image.
  @param {string} [color] - Swatch colour, used when there is no image.
  @param {string} [text] - Short text shown in the swatch instead of an image (tee lengths).
  @param {string} class - CSS classes of the link.
  @param {boolean} current - The card shows this one.
  @param {boolean} [pick] - Draw a button that shows the variant's photo on the card instead of a link.
  @param {number} [media_id] - With pick: id of the variant's photo in the card gallery.
  @param {number} [price] - With pick: the variant's price, shown on the card.
  @param {boolean} [soon] - With pick: the variant is "coming soon"; its click shows a "Coming soon" panel on the card.
  @param {string} [name] - With soon: the option value shown on that panel (e.g. "Pink").
  @param {object} [card_image] - With pick, for a sister page (bath bomb scent): its main photo, shown on the card.
  @param {string} [card_title] - With card_image: its product name, shown as the card title.
{%- enddoc -%}
{%- capture ea_inside -%}
  {%- if text != blank -%}
    <span class="ea-swatch-row__text" aria-hidden="true">{{ text | escape }}</span>
  {%- elsif image != blank -%}
    {{ image | image_url: width: 160 | image_tag: alt: '', width: 26, height: 26, loading: 'lazy' }}
  {%- endif -%}
{%- endcapture -%}
<li>
  {%- if pick -%}
    {%- comment -%} A sister page (bath bomb scent) is drawn as a real link to that page, so search engines follow it to
      every scent page; a plain click still only changes the card (script in ea-card-swatch-row; Anu, 28 Oct 2026). {%- endcomment -%}
    {%- if card_image != blank -%}
      <a href="{{ url }}" role="button"
    {%- else -%}
      <button type="button"
    {%- endif %}
      class="{{ class }} ea-swatch-row__pick"
      title="{{ title | escape }}"
      aria-label="{{ title | escape }}"
      aria-pressed="{{ current }}"
      data-media-id="{{ media_id }}"
      data-url="{{ url }}"
      data-price="{{ price | money }}"
      {% if card_image != blank %}
        data-image-src="{{ card_image | image_url: width: 800 }}"
        data-image-srcset="{{ card_image | image_url: width: 400 }} 400w, {{ card_image | image_url: width: 800 }} 800w, {{ card_image | image_url: width: 1200 }} 1200w"
        data-image-alt="{{ card_image.alt | escape }}"
        data-card-title="{{ card_title | escape }}"
      {% endif %}
      {% if soon %}
        data-soon="{{ name | escape }}"
        data-color="{{ color }}"
      {% endif %}
      {% if image == blank and color != blank %}
        style="background: {{ color }};"
      {% endif %}
    >
      {{- ea_inside -}}
    {%- if card_image != blank -%}</a>{%- else -%}</button>{%- endif -%}
  {%- else -%}
    <a
      href="{{ url }}"
      class="{{ class }}"
      title="{{ title | escape }}"
      aria-label="{{ title | escape }}"
      {% if current %}
        aria-current="true"
      {% endif %}
      {% if image == blank and color != blank %}
        style="background: {{ color }};"
      {% endif %}
    >
      {{- ea_inside -}}
    </a>
  {%- endif -%}
</li>
