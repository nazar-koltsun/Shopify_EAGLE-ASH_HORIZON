{%- doc -%}
  Eagle & Ash "Gift Ideas" page (Anu, 1 Nov 2026: a separate page that links to all gift collections, instead of the
  menu item opening the Christmas collection). The page's own text (written in the admin page editor) as the intro,
  then one card per collection: photo (the collection image, else its first product), title, one line from the
  collection field custom.card_text, and a link. Order = the handles list.

  @param {string} intro - The page text (page.content).
  @param {string} handles - Collection handles, separated by commas.
  @param {string} [note] - Optional line under the cards (3 Nov 2026: the printable cards), e.g. "Giving a round instead?"
  @param {string} [note_link] - Link text after the line.
  @param {string} [note_url] - Where the link goes.
  @param {string} [extra_title] - Optional last card that is not a collection (13 Nov 2026: the golf course gift guide page).
  @param {string} [extra_text] - Its one line.
  @param {string} [extra_url] - Its link.
  @param {string} [extra_image] - A theme asset file name for its photo.
  @param {string} [extra_more] - Its link text, e.g. "See the courses →".
  @param {string} [guides] - Optional row of blog links under the cards: "Label|url;Label|url" (13 Nov 2026).
  @param {string} [guides_label] - Text before the links, e.g. "Stories and guides:".
{%- enddoc -%}
<div class="ea-gift-ideas">
  {%- if intro != blank -%}
    <div class="ea-gift-ideas__intro rte">{{ intro }}</div>
  {%- endif -%}
  <ul class="ea-gift-ideas__grid">
    {%- assign ea_handles = handles | split: ',' -%}
    {%- for ea_h in ea_handles -%}
      {%- assign ea_hs = ea_h | strip -%}
      {%- assign ea_c = collections[ea_hs] -%}
      {%- if ea_c == blank or ea_c.products_count == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign ea_img = ea_c.image | default: ea_c.featured_image -%}
      <li class="ea-gift-ideas__card">
        <a href="{{ ea_c.url }}" class="ea-gift-ideas__link">
          {%- if ea_img -%}
            <span class="ea-gift-ideas__media">
              {{ ea_img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw', alt: ea_c.title }}
            </span>
          {%- endif -%}
          <span class="ea-gift-ideas__title">{{ ea_c.title | escape }}</span>
          {%- if ea_c.metafields.custom.card_text != blank -%}
            <span class="ea-gift-ideas__text">{{ ea_c.metafields.custom.card_text.value | escape }}</span>
          {%- endif -%}
          <span class="ea-gift-ideas__more">See the gifts →</span>
        </a>
      </li>
    {%- endfor -%}
    {%- if extra_title != blank and extra_url != blank -%}
      <li class="ea-gift-ideas__card">
        <a href="{{ extra_url }}" class="ea-gift-ideas__link">
          {%- if extra_image != blank -%}
            <span class="ea-gift-ideas__media">
              <img src="{{ extra_image | asset_url }}" alt="{{ extra_title | escape }}" loading="lazy" width="1200" height="900">
            </span>
          {%- endif -%}
          <span class="ea-gift-ideas__title">{{ extra_title | escape }}</span>
          {%- if extra_text != blank -%}<span class="ea-gift-ideas__text">{{ extra_text | escape }}</span>{%- endif -%}
          <span class="ea-gift-ideas__more">{{ extra_more | default: 'See more →' | escape }}</span>
        </a>
      </li>
    {%- endif -%}
  </ul>
  {%- if guides != blank -%}
    <p class="ea-gift-ideas__guides">
      <span>{{ guides_label | default: 'Stories and guides:' | escape }}</span>
      {%- assign ea_gl = guides | split: ';' -%}
      {%- for ea_g in ea_gl -%}
        {%- assign ea_gp = ea_g | split: '|' -%}
        <a href="{{ ea_gp[1] | strip }}">{{ ea_gp[0] | strip | escape }}</a>{%- unless forloop.last -%}<span aria-hidden="true"> · </span>{%- endunless -%}
      {%- endfor -%}
    </p>
  {%- endif -%}
  {%- if note != blank and note_url != blank -%}
    <p class="ea-gift-ideas__note">{{ note | escape }} <a href="{{ note_url }}">{{ note_link | default: 'See more' | escape }}</a></p>
  {%- endif -%}
</div>

{% stylesheet %}
  /* row of blog links under the cards (13 Nov 2026) */
  .ea-gift-ideas__guides {
    margin: 56px 0 0;
    text-align: center;
    font-size: 17px;
    line-height: 1.8;

    span:first-child { font-weight: 600; margin-right: 6px; }
    a { color: #b83a00; font-weight: 600; text-underline-offset: 3px; }
  }
  .ea-gift-ideas__guides + .ea-gift-ideas__note { margin-top: 16px; }

  /* one line under the cards that leads to the printable cards (3 Nov 2026); the small-text orange #b83a00 on white */
  .ea-gift-ideas__note {
    margin: 64px 0 0;
    text-align: center;
    font-size: 17px;

    a {
      color: #b83a00;
      font-weight: 600;
      text-underline-offset: 3px;
    }

    @media screen and (max-width: 749px) {
      margin-block-start: 44px;
    }
  }

  .ea-gift-ideas {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding: 48px var(--page-margin, 20px) 64px;
  }

  .ea-gift-ideas__intro {
    max-width: 760px;
    margin-block-end: 32px;
    font-size: 18px;
    line-height: 1.55;

    @media screen and (max-width: 749px) {
      font-size: 16px;
    }
  }

  /* one card per row on phones, two on tablets, four on computers: the cards show wide scene photos (1 Nov 2026) */
  .ea-gift-ideas__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px 16px;

    @media screen and (min-width: 600px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    margin: 0;
    padding: 0;
    list-style: none;

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 40px 24px;
    }
  }

  /* exactly five cards (8 Nov 2026: Golf Gifts for Men added): one row of five from 1200 px, three + two below,
     so no card stands alone in a second row */
  /* six cards: two rows of three on computers (13 Nov 2026) */
  .ea-gift-ideas__grid:has(> li:nth-child(6):last-child) {
    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .ea-gift-ideas__grid:has(> li:nth-child(5):last-child) {
    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    @media screen and (min-width: 1200px) {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .ea-gift-ideas__link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  /* 3:2 like the collection banner photos (Anu's GPT scenes are 1536 x 1024); products stand right of centre */
  .ea-gift-ideas__media {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #f4f6f6;
  }

  .ea-gift-ideas__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 55%;
    transition: transform 0.4s ease;
  }

  .ea-gift-ideas__link:hover .ea-gift-ideas__media img {
    transform: scale(1.03);
  }

  .ea-gift-ideas__title {
    margin-block-start: 8px;
    font-family: var(--font-heading--family);
    font-size: 22px;
    line-height: 1.25;

    @media screen and (max-width: 749px) {
      font-size: 18px;
    }
  }

  .ea-gift-ideas__text {
    font-size: 15px;
    line-height: 1.5;

    @media screen and (max-width: 749px) {
      font-size: 14px;
    }
  }

  .ea-gift-ideas__more {
    margin-block-start: auto;
    padding-block-start: 4px;
    font-weight: 600;
    color: #b83a00;
  }
{% endstylesheet %}
