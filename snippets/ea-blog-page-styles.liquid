{%- comment -%}
  Blog list page (/blogs/golf, "Stories and guides"): page title like every page title (Lora 400, 32 px from 750 px,
  24 px on phones) and the intro in Roboto. {% stylesheet %} tags are bundled for the whole theme, so this snippet
  does not need to be rendered anywhere. 12 Nov 2026.
{%- endcomment -%}
{% stylesheet %}
  .shopify-section:has(.blog-posts-container) .text-block h1 {
    font-family: var(--font-heading--family, 'Lora'), serif;
    font-weight: 400;
    font-size: 24px;
    line-height: 1.25;
  }
  @media screen and (min-width: 750px) {
    .shopify-section:has(.blog-posts-container) .text-block h1 { font-size: 32px; }
  }
  .shopify-section:has(.blog-posts-container) .text-block p { font-family: var(--font-body--family, 'Roboto'), sans-serif; font-size: 17px; line-height: 1.6; max-width: 680px; }
  /* "Read more..." under each post card in our dark orange like all text links (Anu, 13 Nov 2026) */
  .blog-posts-container .rte a[href*="/blogs/"] { color: #b83a00; font-weight: 600; text-underline-offset: 3px; }
  .blog-posts-container .rte a[href*="/blogs/"]:hover { color: #8a2c00; }
  /* blog cards (13 Nov 2026): label on the picture, card titles 22 px like all card titles, summary, specific link */
  .ea-blog-card-media { position: relative; }
  .ea-blog-card-label {
    position: absolute; z-index: 1; top: 14px; left: 14px;
    padding: 7px 12px; border-radius: 3px; background: #07272d; color: #ffffff;
    font-family: var(--font-body--family, 'Roboto'), sans-serif; font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; line-height: 1.2;
  }
  .blog-posts-container .blog-post-card__content :is(h1, h2, h3, h4) { font-size: 22px; line-height: 1.3; font-weight: 500; }
  .blog-posts-container .ea-blog-card-summary { display: block; margin-bottom: 14px; }
  .blog-posts-container .ea-blog-card-link { display: inline-block; color: #b83a00; font-weight: 700; text-decoration: none; }
  .blog-posts-container .ea-blog-card-link:hover { text-decoration: underline; text-underline-offset: 3px; }
  /* one post per row (13 Nov 2026): picture 55 %, text 45 %, text centred against the picture; stacked on phones */
  @media screen and (min-width: 750px) {
    .blog-posts-container .blog-post-item--horizontal .blog-post-card { column-gap: 40px; align-items: center; }
    .blog-posts-container .blog-post-item--horizontal:has(.blog-post-card__image-container) .blog-post-card > *:first-child { flex-basis: 55%; }
    .blog-posts-container .blog-post-item--horizontal:has(.blog-post-card__image-container) .blog-post-card > *:last-child { flex-basis: 45%; }
  }
  .blog-posts-container .blog-post-item + .blog-post-item { padding-top: 36px; border-top: 1px solid #d5ebee; }
  /* filter buttons: same pills as the course guide's state list */
  .ea-blog-filter { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 36px; }
  .ea-blog-filter__pill { display: inline-flex; align-items: center; min-height: 40px; padding: 0 18px; border-radius: 999px; background: #ffffff; box-shadow: inset 0 0 0 1px #b9d9de; color: #07272d; font-family: var(--font-body--family, 'Roboto'), sans-serif; font-size: 16px; text-decoration: none; }
  .ea-blog-filter__pill:hover { background: #edf6f8; color: #b83a00; }
  .ea-blog-filter__pill.is-active { background: #07272d; box-shadow: none; color: #ffffff; }
{% endstylesheet %}
