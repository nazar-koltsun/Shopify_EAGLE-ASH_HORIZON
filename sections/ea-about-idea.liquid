{%- doc -%}
  Eagle & Ash About page (Anu, 30 Oct 2026, canvas round 14-15): light blue band "Have a gift idea we should make?" with a
  link to the Contact page, then the email sign-up (Klaviyo, source "About page: gift idea band") and the small print on
  ideas (goodwill, not an agreement; Anu: we would give credit when it is due, but it is not a promise).
{%- enddoc -%}
<div class="ea-about-idea">
  <h2 class="ea-about-section-title">{{ section.settings.heading | escape }}</h2>
  {%- if section.settings.line != blank -%}<p class="ea-about-idea__line">{{ section.settings.line | escape }}</p>{%- endif -%}
  {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
    <a class="ea-about-idea__link" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>
  {%- endif -%}
  {%- if section.settings.signup_line != blank -%}<p class="ea-about-idea__signup-line">{{ section.settings.signup_line | escape }}</p>{%- endif -%}
  {%- if section.settings.klaviyo_company != blank and section.settings.klaviyo_list != blank -%}
    <div class="ea-about-idea__form">
      {%- render 'email-signup-klaviyo-form',
        klaviyo_company_id: section.settings.klaviyo_company,
        klaviyo_list_id: section.settings.klaviyo_list,
        label: 'SIGN UP',
        show_interest: false,
        form_id: 'about-signup',
        custom_source: 'About page: gift idea band',
        privacy_notice: section.settings.privacy
      -%}
    </div>
  {%- endif -%}
  {%- if section.settings.small_print != blank -%}<p class="ea-about-idea__small">{{ section.settings.small_print | escape }}</p>{%- endif -%}
</div>

{% stylesheet %}
  .ea-about-idea {
    background: #d5ebee;
    padding: 48px 16px 44px;
    text-align: center;
    color: #07272d;
  }

  .ea-about-idea .ea-about-section-title { margin-bottom: 12px; }

  .ea-about-idea__line { margin: 0; font-size: 18px; color: #16282d; }

  .ea-about-idea__link {
    display: inline-block;
    margin-top: 8px;
    font-weight: 600;
    color: #b83a00;
  }

  .ea-about-idea__signup-line {
    max-width: 640px;
    margin: 22px auto 0;
    font-size: 17px;
    line-height: 1.45;
    color: #16282d;
  }

  .ea-about-idea__form { max-width: 560px; margin: 16px auto 0; }

  /* the form as in the homepage sign-up band (snippets/ea-home-signup), on light blue */
  .ea-about-idea__form .email-signup-klaviyo__form-wrap { display: flex; gap: 8px; }
  .ea-about-idea__form .email-signup__fields { flex: 1; }

  .ea-about-idea .ea-about-idea__form .email-signup-klaviyo__input-group { background: #fff; border-radius: 4px; }

  .ea-about-idea .ea-about-idea__form .email-signup-klaviyo__input {
    width: 100%;
    min-height: 48px;
    padding: 0 14px;
    border: 1px solid #9fbfc5;
    border-radius: 4px;
    background: #fff;
    color: #001e26;
  }

  .ea-about-idea__form .email-signup-klaviyo__button {
    min-height: 48px;
    padding: 0 20px;
    border: 0;
    border-radius: 4px;
    background: #fd5000;
    color: #fff;
    font-size: 1.1875rem;
    font-weight: 700;
    font-family: var(--font-body--family);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .ea-about-idea__form .email-signup-klaviyo__privacy,
  .ea-about-idea__form .email-signup-klaviyo__privacy a,
  .ea-about-idea__form .email-signup-klaviyo__message-text { color: #16282d; }

  .ea-about-idea__small {
    max-width: 660px;
    margin: 16px auto 0;
    font-size: 13px;
    line-height: 1.5;
    color: #3d5257;
  }

  @media screen and (min-width: 750px) {
    .ea-about-idea { padding: 60px 40px 56px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "E&A About: idea + sign-up",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Title", "default": "Have a gift idea we should make?" },
    { "type": "text", "id": "line", "label": "Line under the title" },
    { "type": "text", "id": "link_label", "label": "Link text" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "text", "id": "signup_line", "label": "Line above the sign-up" },
    { "type": "text", "id": "klaviyo_company", "label": "Klaviyo company id", "default": "RMHHKa" },
    { "type": "text", "id": "klaviyo_list", "label": "Klaviyo list id", "default": "Rcmc4K" },
    { "type": "richtext", "id": "privacy", "label": "Privacy line" },
    { "type": "textarea", "id": "small_print", "label": "Small print on ideas" }
  ]
}
{% endschema %}
