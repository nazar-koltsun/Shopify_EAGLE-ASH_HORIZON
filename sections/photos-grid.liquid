      },
      {
        "type": "image_picker",
        "id": "image_1",
        "label": "Image 1 (left)"
      },
      {
        "type": "image_picker",
        "id": "image_2",
        "label": "Image 2 (tall)"
      },
      {
        "type": "image_picker",
        "id": "image_3",
        "label": "Image 3"
      },
      {
        "type": "image_picker",
        "id": "image_4",
        "label": "Image 4 (right)"
      },
      {
        "type": "header",
        "content": "Bottom row"
      },
      {
        "type": "image_picker",
        "id": "image_5",
        "label": "Image 5 (left)"
      },
      {
        "type": "image_picker",
