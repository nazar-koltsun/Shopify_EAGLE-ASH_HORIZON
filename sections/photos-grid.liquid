{%- liquid
  assign image_1 = section.settings.image_1
  assign image_2 = section.settings.image_2
  assign image_3 = section.settings.image_3
  assign image_4 = section.settings.image_4
  assign image_5 = section.settings.image_5
  assign image_6 = section.settings.image_6
  assign image_7 = section.settings.image_7
-%}

<div class="photos-grid">
  <div class="photos-grid__inner">
    <div class="photos-grid__item photos-grid__item--1">
      {%- if image_1 != blank -%}
        {{
          image_1
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1200',
            sizes: '(max-width: 749px) 50vw, 22vw',
            class: 'photos-grid__image',
            alt: image_1.alt
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'photos-grid__image photos-grid__image--placeholder' }}
      {%- endif -%}
    </div>

    <div class="photos-grid__item photos-grid__item--2">
      {%- if image_2 != blank -%}
