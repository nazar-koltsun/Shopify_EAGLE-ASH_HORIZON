{% stylesheet %}
  .section-photos-grid {
    background-color: #ffffff;
  }

  .photos-grid {
    width: 100%;
    background-color: #ffffff;
  }

  .photos-grid__inner {
    display: grid;
    grid-template-columns: 301fr 467fr 301fr 301fr;
    grid-template-rows: 1fr 1fr;
    gap: 19px;
    width: 100%;
    max-width: 1920px;
    margin-inline: auto;

    @media screen and (max-width: 1200px) {
      gap: 16px;
    }

    @media screen and (max-width: 749px) {
      gap: 6px;
    }
  }

  .photos-grid__item {
    position: relative;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
    background-color: rgba(7, 39, 45, 0.06);
    aspect-ratio: 301 / 373;
  }

  .photos-grid__item--1 {
    grid-column: 1;
    grid-row: 1;
  }

  .photos-grid__item--2 {
    grid-column: 2;
    grid-row: 1 / -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photos-grid__item--3 {
    grid-column: 3;
    grid-row: 1;
  }

  .photos-grid__item--4 {
    grid-column: 4;
    grid-row: 1;
  }

  .photos-grid__item--5 {
    grid-column: 1;
    grid-row: 2;
  }

  .photos-grid__item--6 {
    grid-column: 3;
    grid-row: 2;
  }

  .photos-grid__item--7 {
    grid-column: 4;
    grid-row: 2;
  }

  .photos-grid__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photos-grid__image--placeholder {
    background-color: var(--blue-spectrum-dark, #07272d);
    fill: var(--blue-spectrum-light, #d9e2e3);
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Photos Grid",
    "class": "section-wrapper section-photos-grid",
    "tag": "section",
    "settings": [
      {
        "type": "header",
