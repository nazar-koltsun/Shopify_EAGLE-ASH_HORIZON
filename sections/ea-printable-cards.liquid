{%- comment -%}
  Eagle & Ash, 3 Nov 2026 (Anu: "make the designs as visible cards with download link near them, and the same message
  idea as the block already has"): gift ideas that cannot be wrapped (a round, a lesson), each with a printable card
  to download. One block per idea: title, text, up to two card designs (preview picture + PDF from Shopify Files,
  by file name). Replaces the collection description text on the Has Everything page.
{%- endcomment -%}
<div class="section-background color-{{ section.settings.color_scheme }} ea-print-cards-bg"></div>
<div id="printable-cards" class="section section--page-width ea-print-cards spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
  {%- if section.settings.heading != blank -%}
    <h2 class="ea-print-cards__heading">{%- render 'ea-accent-text', text: section.settings.heading -%}</h2>
  {%- endif -%}
  {%- if section.settings.intro != blank -%}
    <p class="ea-print-cards__intro">{{ section.settings.intro | escape }}</p>
  {%- endif -%}

  <div class="ea-print-cards__ideas">
    {%- for block in section.blocks -%}
      <article class="ea-print-cards__idea" {{ block.shopify_attributes }}>
        <div class="ea-print-cards__designs">
          {%- for i in (1..2) -%}
            {%- liquid
              assign k_image = 'image_' | append: i
              assign k_pdf = 'pdf_' | append: i
              assign k_label = 'label_' | append: i
              assign ea_image = block.settings[k_image]
              assign ea_pdf = block.settings[k_pdf]
            -%}
            {%- if ea_image != blank and ea_pdf != blank -%}
              <figure class="ea-print-cards__design">
                <a class="ea-print-cards__preview" href="{{ ea_pdf | file_url }}" target="_blank" rel="noopener">
                  {{- ea_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 300, 400, 600', sizes: '(max-width: 749px) 44vw, 220px', class: 'ea-print-cards__image', alt: ea_image.alt -}}
                </a>
                {%- comment -%} 3 Nov 2026 (Anu): the card's name, then two equal downloads, US Letter and A4, each with the
                  download arrow (before: one main link plus a small "A4 version", which read as if the main file were A4). {%- endcomment -%}
                {%- assign ea_name = block.settings[k_label] | default: 'The card' -%}
                {%- assign k_a4 = 'a4_' | append: i -%}
                <figcaption>
                  <span class="ea-print-cards__name">{{ ea_name | escape }}</span>
                  <span class="ea-print-cards__downloads">
                    <a class="ea-print-cards__download" href="{{ ea_pdf | file_url }}" target="_blank" rel="noopener">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg>
                      US Letter<span class="visually-hidden">: {{ ea_name | escape }}, PDF (opens in a new tab)</span>
                    </a>
                    {%- if block.settings[k_a4] != blank -%}
                      <a class="ea-print-cards__download" href="{{ block.settings[k_a4] | file_url }}" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg>
                        A4<span class="visually-hidden">: {{ ea_name | escape }}, PDF (opens in a new tab)</span>
                      </a>
                    {%- endif -%}
                  </span>
                </figcaption>
              </figure>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="ea-print-cards__text">
          {%- if block.settings.title != blank -%}
            <h3 class="ea-print-cards__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {{ block.settings.text }}
        </div>
      </article>
    {%- endfor -%}
  </div>

  {%- if section.settings.note != blank -%}
    <p class="ea-print-cards__note">{{ section.settings.note | escape }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  /* the light-blue band of "Complete the set" (Soaring Brand Blue #d5ebee) */
  .shopify-section:has(> .ea-print-cards-bg) {
    background-color: var(--soaring-brand-blue, #d5ebee);
  }

  .ea-print-cards {
    color: #001e26;
    /* the Gift Ideas page links here (#printable-cards): stop below the sticky menu bar */
    scroll-margin-top: calc(var(--header-height, 80px) + 8px);
  }

  /* the site's section heading size: 30 px on computers, 24 px on phones and tablets (3 Nov 2026) */
  .ea-print-cards__heading {
    margin: 0;
    text-align: center;
    font-size: 30px;
    line-height: 1.3;

    @media screen and (max-width: 990px) {
      font-size: 24px;
    }
  }

  /* orange on the light blue: #e04800 (as the About page's light-blue block) */
  .ea-print-cards__heading .ea-accent {
    color: #e04800;
  }

  .ea-print-cards__intro {
    max-width: 640px;
    margin: 16px auto 0;
    text-align: center;
    font-size: 17px;
    line-height: 1.55;
  }

  .ea-print-cards__ideas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
    margin-block-start: 48px;

    @media screen and (max-width: 989px) {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }

  /* one idea only (golf course gift guide, 9 Nov 2026): one centred card instead of half a row */
  .ea-print-cards__ideas:has(> .ea-print-cards__idea:only-child) {
    grid-template-columns: minmax(0, 640px);
    justify-content: center;
  }

  .ea-print-cards__idea {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 40px 40px 36px;
    border-radius: 8px;
    background: #fff;

    @media screen and (max-width: 749px) {
      padding: 20px 16px;
    }
  }

  .ea-print-cards__designs {
    display: flex;
    justify-content: center;
    gap: 20px;
  }

  .ea-print-cards__design {
    flex: 0 1 220px;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .ea-print-cards__preview {
    display: block;
    width: 100%;
  }

  /* the card as a sheet of paper */
  .ea-print-cards__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
    box-shadow: 0 2px 4px rgb(0 30 38 / 0.12), 0 8px 20px rgb(0 30 38 / 0.12);
  }

  /* the small-text orange #b83a00 on white: 5.9:1 */
  .ea-print-cards__download {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: #b83a00;
    font-weight: 600;
    text-align: center;
    text-underline-offset: 3px;

    white-space: nowrap;

    @media screen and (max-width: 749px) {
      font-size: 14px;
    }
  }

  /* card title 22 px like the other card titles on the site (19 px on phones) */
  .ea-print-cards__design figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  /* the card's name (all three in the same style), then the two downloads side by side */
  .ea-print-cards__name {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
  }

  .ea-print-cards__downloads {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 20px;
  }

  .ea-print-cards__title {
    margin: 0 0 12px;
    font-size: 22px;
    line-height: 1.3;

    @media screen and (max-width: 749px) {
      font-size: 19px;
    }
  }

  .ea-print-cards__text p {
    margin: 0 0 8px;
    line-height: 1.55;
  }

  .ea-print-cards__text a {
    color: #b83a00;
    text-underline-offset: 3px;
  }

  .ea-print-cards__note {
    margin: 36px auto 0;
    max-width: 640px;
    text-align: center;
    font-size: 15px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Printable gift cards",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Words between two stars are orange." },
    { "type": "textarea", "id": "intro", "label": "Text under the heading" },
    { "type": "text", "id": "note", "label": "Line under the ideas" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding-block-start", "label": "Space above", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding-block-end", "label": "Space below", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "idea",
      "name": "Gift idea with a card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "image_picker", "id": "image_1", "label": "Card 1: preview picture" },
        { "type": "text", "id": "pdf_1", "label": "Card 1: US Letter PDF file name in Shopify Files" },
        { "type": "text", "id": "label_1", "label": "Card 1: name under the picture", "default": "The card" },
        { "type": "text", "id": "a4_1", "label": "Card 1: A4 PDF file name (optional)" },
        { "type": "image_picker", "id": "image_2", "label": "Card 2 (optional): preview picture" },
        { "type": "text", "id": "pdf_2", "label": "Card 2: US Letter PDF file name in Shopify Files" },
        { "type": "text", "id": "label_2", "label": "Card 2: name under the picture" },
        { "type": "text", "id": "a4_2", "label": "Card 2: A4 PDF file name (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "Printable gift cards" }]
}
{% endschema %}
