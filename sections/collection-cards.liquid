{%- liquid
  assign heading = section.settings.heading
-%}

<div
  class="collection-cards{% if section.settings.color_style == 'light' or section.settings.color_style == 'blue' %} collection-cards--light{% endif %}{% if section.settings.color_style == 'blue' %} collection-cards--blue{% endif %}{% if section.settings.back_color == 'dark_blue' %} collection-cards--back-blue{% endif %}{% if section.settings.review_look == 'bubble' %} collection-cards--bubble{% endif %}{% if section.settings.title_position == 'top' %} collection-cards--title-top{% endif %}"
  style="--cc-back-image: url('{{ 'card-back-bg.webp' | asset_url }}');"
>
  <div class="collection-cards__inner">
    {%- if heading != blank or section.blocks.size > 1 -%}
      <div class="collection-cards__header{% if section.settings.heading_alignment == 'center' %} collection-cards__header--center{% endif %}">
        {%- if heading != blank -%}
          <div class="collection-cards__titles">
            <h2 class="collection-cards__heading">{{ heading }}</h2>
            {%- if section.settings.subheading != blank -%}
              <p class="collection-cards__subheading">{{ section.settings.subheading | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 1 -%}
          <div class="collection-cards__nav" data-embla-nav aria-label="Carousel navigation">
            <button
              type="button"
              class="collection-cards__nav-btn"
              data-embla-prev
              aria-label="Previous collections"
            >
              <span class="collection-cards__nav-icon collection-cards__nav-icon--prev">
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </span>
            </button>
            <button
              type="button"
              class="collection-cards__nav-btn"
              data-embla-next
              aria-label="Next collections"
            >
              <span class="collection-cards__nav-icon">
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="embla collection-cards__embla"
        id="collection-cards-{{ section.id }}"
        role="region"
        aria-roledescription="carousel"
        aria-label="{{ heading | default: 'Collections' | strip_html | escape }}"
      >
        <div class="embla__viewport collection-cards__viewport" data-embla-viewport>
          <div class="embla__container collection-cards__container" role="list">
            {%- for block in section.blocks -%}
              {%- liquid
                assign card_image = block.settings.image
                assign card_title = block.settings.title
                assign back_title = block.settings.back_title
                assign back_text = block.settings.back_text
                assign back_action_title = block.settings.back_action_title
                assign back_action_url = block.settings.back_action_url
              -%}
              <div class="embla__slide collection-cards__item" role="listitem" {{ block.shopify_attributes }}>
                <div
                  class="collection-cards__card"
                  data-flip-card
                  tabindex="0"
                  aria-label="{{ card_title | replace: ' | ', ' ' | default: 'Collection card' | strip_html | escape }}. Activate to flip."
                >
                  <div class="collection-cards__flipper">
                    <div class="collection-cards__face collection-cards__face--front">
                      <div class="collection-cards__media">
                        {%- if card_image != blank -%}
                          <img
                            class="collection-cards__image"
                            src="{{ card_image | image_url: width: 600 }}"
                            srcset="
                              {{ card_image | image_url: width: 300 }} 300w,
                              {{ card_image | image_url: width: 450 }} 450w,
                              {{ card_image | image_url: width: 600 }} 600w,
                              {{ card_image | image_url: width: 900 }} 900w
                            "
                            sizes="(max-width: 720px) 40vw, (max-width: 1199px) 30vw, 20vw"
                            width="{{ card_image.width }}"
                            height="{{ card_image.height }}"
                            alt="{{ card_image.alt | escape }}"
                            loading="lazy"
                            draggable="false"
                          >
                        {%- else -%}
                          {{ 'collection-1' | placeholder_svg_tag: 'collection-cards__image collection-cards__image--placeholder' }}
                        {%- endif -%}

                        </div>
                        {%- if card_title != blank -%}
                          {%- comment -%} Eagle & Ash: " | " in the title starts a new line {%- endcomment -%}
                          {%- if section.settings.title_position == 'top' -%}
                            <span class="collection-cards__title">{{ card_title | escape | replace: ' | ', ' ' }}</span>
                          {%- else -%}
                            <span class="collection-cards__title">{{ card_title | escape | replace: ' | ', '<br>' }}</span>
                          {%- endif -%}
                        {%- endif -%}
                        {%- comment -%} Anu, 30 Oct 2026 (Yvelin): show on the card that it turns over; the card's own label already says it to screen readers {%- endcomment -%}
                        {%- if section.settings.flip_hint != blank -%}
                          <span class="collection-cards__flip-hint" aria-hidden="true">{{ section.settings.flip_hint | escape }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></svg></span>
                        {%- endif -%}
                    </div>

                    {%- comment -%} Eagle & Ash, Oct 2026: "inert" instead of aria-hidden, so the link on the back cannot get keyboard focus while the card shows its front (axe: aria-hidden-focus); aria-expanded removed from the card, a div without a role may not carry it (axe: aria-allowed-attr). {%- endcomment -%}
                    <div class="collection-cards__face collection-cards__face--back" inert>
                      <div class="collection-cards__back-body">
                        {%- if back_title != blank -%}
                          <h3 class="collection-cards__back-title">{{ back_title }}</h3>
                        {%- endif -%}

                        {%- comment -%} Eagle & Ash, 29 Oct 2026 (Anu liked canvas option D): the gifts' photos on the back, each a link to its page {%- endcomment -%}
                        {%- if block.settings.back_products != blank -%}
                          <ul class="collection-cards__gifts" role="list">
                            {%- for gift in block.settings.back_products -%}
                              <li>
                                <a href="{{ gift.url }}" data-flip-ignore>
                                  {{- gift.featured_image | image_url: width: 300 | image_tag: alt: gift.title, loading: 'lazy', class: 'collection-cards__gift-image' -}}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}

                        {%- if back_text != blank -%}
                          <p class="collection-cards__back-text">{{ back_text | newline_to_br }}</p>
                        {%- endif -%}

                        {%- if back_action_title != blank -%}
                          {%- if back_action_url != blank -%}
                            <a class="collection-cards__back-action btn btn--white" href="{{ back_action_url }}" data-flip-ignore>
                              {{- back_action_title | escape -}}
                            </a>
                          {%- else -%}
                            <span class="collection-cards__back-action">{{ back_action_title | escape }}</span>
                          {%- endif -%}
                        {%- endif -%}
                      </div>

                      {%- comment -%} Eagle & Ash, Oct 2026: the words under the card were fixed ("Wholesale Retail Bespoke"); now an optional setting, "·" between the words. {%- endcomment -%}
                      {%- if block.settings.back_tags != blank -%}
                        <div class="collection-cards__back-features">
                          {%- assign back_tags = block.settings.back_tags | split: '·' -%}
                          {%- for tag in back_tags -%}
                            <span class="collection-cards__back-feature">{{ tag | strip | escape }}</span>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>

                {%- comment -%} Eagle & Ash, Oct 2026: optional Amazon quote under the card (testimonial entry by its handle); Vine reviews are labelled (US FTC).
                  Same look as the white review cards on the product pages: orange quotation mark, serif italic quote, source in small capitals (Anu, 28 Oct 2026). {%- endcomment -%}
                {%- if block.settings.quote != blank -%}
                  {%- assign ea_quote = metaobjects.ea_testimonial[block.settings.quote] -%}
                  {%- if ea_quote != blank -%}
                    <figure class="collection-cards__quote">
                      <span class="collection-cards__quote-mark" aria-hidden="true">“</span>
                      <blockquote class="collection-cards__quote-text">{{ ea_quote.quote.value | escape }}</blockquote>
                      <figcaption class="collection-cards__quote-source">
                        {%- if ea_quote.name.value != blank -%}{{ ea_quote.name.value | escape }} · {% endif -%}
                        {%- if ea_quote.vine.value == true -%}Amazon Vine review · product received free{%- else -%}Amazon customer review{%- endif -%}
                      </figcaption>
                    </figure>
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
    {%- if section.settings.footnote != blank -%}
      <p class="collection-cards__footnote">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</div>

<script type="module">
  import EmblaCarousel from '{{ 'embla-carousel.esm.js' | asset_url }}';

  (function () {
    var root = document.getElementById('collection-cards-{{ section.id }}');
    if (!root || root.dataset.emblaInit === 'true') return;

    var viewport = root.querySelector('[data-embla-viewport]');
    if (!viewport) return;

    root.dataset.emblaInit = 'true';

    var embla = EmblaCarousel(viewport, {
      loop: false,
      align: 'start',
      dragFree: false,
      containScroll: 'trimSnaps',
    });

    var sectionEl = root.closest('.collection-cards');
    var nav = sectionEl && sectionEl.querySelector('[data-embla-nav]');
    var prevBtn = sectionEl && sectionEl.querySelector('[data-embla-prev]');
    var nextBtn = sectionEl && sectionEl.querySelector('[data-embla-next]');

    function updateNavButtons() {
      var canPrev = embla.canScrollPrev();
      var canNext = embla.canScrollNext();
      var needsNav = canPrev || canNext;

      if (nav) {
        if (needsNav) {
          nav.classList.remove('collection-cards__nav--hidden');
        } else {
          nav.classList.add('collection-cards__nav--hidden');
        }
      }

      if (prevBtn) prevBtn.disabled = !canPrev;
      if (nextBtn) nextBtn.disabled = !canNext;
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        embla.scrollPrev();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        embla.scrollNext();
      });
    }

    embla.on('select', updateNavButtons);
    embla.on('reInit', updateNavButtons);
    embla.on('resize', updateNavButtons);
    updateNavButtons();

    // Arrows at the middle of the photos (CSS reads --cc-arrow-top on the inner wrapper)
    var inner = sectionEl && sectionEl.querySelector('.collection-cards__inner');
    function placeNav() {
      var media = root.querySelector('.collection-cards__media');
      if (!inner || !media) return;
      var m = media.getBoundingClientRect();
      inner.style.setProperty('--cc-arrow-top', m.top - inner.getBoundingClientRect().top + m.height / 2 + 'px');
    }
    placeNav();
    embla.on('resize', placeNav);
    window.addEventListener('resize', placeNav);

    var startX = 0;
    var startY = 0;
    var dragged = false;
    var DRAG_THRESHOLD = 8;

    function setFlipped(card, flipped) {
      card.classList.toggle('is-flipped', flipped);
      var back = card.querySelector('.collection-cards__face--back');
      if (back) back.inert = !flipped;
    }

    function unflipOthers(exceptCard) {
      root.querySelectorAll('[data-flip-card].is-flipped').forEach(function (card) {
        if (card !== exceptCard) setFlipped(card, false);
      });
    }

    function toggleCard(card) {
      var next = !card.classList.contains('is-flipped');
      unflipOthers(card);
      setFlipped(card, next);
    }

    root.addEventListener('pointerdown', function (event) {
      if (!event.target.closest('[data-flip-card]')) return;
      startX = event.clientX;
      startY = event.clientY;
      dragged = false;
    });

    root.addEventListener('pointermove', function (event) {
      if (
        Math.abs(event.clientX - startX) > DRAG_THRESHOLD ||
        Math.abs(event.clientY - startY) > DRAG_THRESHOLD
      ) {
        dragged = true;
      }
    });

    root.addEventListener('click', function (event) {
      if (event.target.closest('[data-flip-ignore]')) return;

      var card = event.target.closest('[data-flip-card]');
      if (!card || dragged) return;

      event.preventDefault();
      toggleCard(card);
    });

    root.addEventListener('keydown', function (event) {
      if (event.key !== 'Enter' && event.key !== ' ') return;

      var card = event.target.closest('[data-flip-card]');
      if (!card || event.target.closest('[data-flip-ignore]')) return;

      event.preventDefault();
      toggleCard(card);
    });
  })();
</script>

{% stylesheet %}
  /* Eagle & Ash, 29 Oct 2026 (Anu chose canvas option A, with the gifts' photos of option D on the back): the title on the
     photo, top left, over a soft dark fade; turned over, the explanatory title stands in the same place and size */
  .collection-cards--title-top .collection-cards__face--front {
    gap: 0;
  }

  .collection-cards--title-top .collection-cards__media::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 52%;
    background: linear-gradient(rgb(7 39 45 / 0.82), rgb(7 39 45 / 0.38) 55%, rgb(7 39 45 / 0));
    pointer-events: none;
  }

  .collection-cards--title-top .collection-cards__title,
  .collection-cards--title-top .collection-cards__back-title {
    font-family: 'Lora', serif;
    font-weight: 500;
    font-size: 22px !important;
    line-height: 1.3 !important;
    text-align: start;
    color: #fff !important;

    @media screen and (max-width: 1099px) {
      font-size: 20px !important;
    }

    @media screen and (max-width: 749px) {
      font-size: 19px !important;
    }
  }

  .collection-cards--title-top .collection-cards__title {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 1;
    display: block;
    min-height: 0;
    margin: 0;
    padding: 22px 24px 0;
  }

  .collection-cards--title-top .collection-cards__back-body {
    padding: 22px 24px 24px;
  }

  .collection-cards--title-top .collection-cards__back-text {
    margin-block: 14px 16px;
    font-family: var(--font-body--family, 'Roboto', sans-serif);
    font-weight: 400;
    font-size: 15px;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.9);

    @media screen and (max-width: 1099px) {
      font-size: 14px;
    }
  }

  .collection-cards__gifts {
    display: flex;
    gap: 8px;
    width: 100%;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .collection-cards__gifts li {
    flex: 1 1 0;
    min-width: 0;
    max-width: 50%;
  }

  .collection-cards__gifts a {
    display: block;
    aspect-ratio: 1;
    border-radius: 6px;
    overflow: hidden;
    background: #fff;
  }

  .collection-cards__gift-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .section-collection-cards {
    background-color: var(--deepest-brand-blue);
  }

  .collection-cards {
    --cc-gap: 14px;
    --cc-per-view: 3.13;
    --cc-back-brown: #5c4033;
    width: 100%;
    max-width: 1920px;
    margin-inline: auto;
    /* 72 px above the heading, as the other homepage sections (Anu, 29 Oct 2026: crowded; was 29 px) */
    padding-block-start: 72px;
    background-color: var(--deepest-brand-blue);

    /* four cards in a row, the same width as the product cards above (Anu, 29 Oct 2026; was from 1600 px); below 1100 px
       the titles would need a third line, so three and a bit stay there */
    @media screen and (min-width: 1100px) {
      --cc-per-view: 4;
    }

    @media screen and (max-width: 850px) {
      --cc-per-view: 2.2;
    }

    @media screen and (max-width: 749px) {
      padding-block-start: 48px;
    }

    @media screen and (max-width: 580px) {
      --cc-per-view: 1.2;
    }
  }

  .collection-cards__inner {
    width: 100%;
    max-width: 1920px;
    margin-inline: auto;
  }

  .collection-cards__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-inline: 10px;
  }

  .collection-cards__heading {
    margin: 0;
    font-family: 'Lora', serif;
    font-weight: 500;
    font-size: 30px;
    line-height: 1.3;
    color: white;

    @media screen and (max-width: 1200px) {
      font-size: 28px;
    }

    @media screen and (max-width: 990px) {
      font-size: 24px;
    }

    @media screen and (max-width: 749px) {
      font-size: 20px;
    }
  }

  /* light and light-blue versions (homepage): 24 px on phones, like the other homepage headings (Anu, 28 Oct 2026) */
  @media screen and (max-width: 749px) {
    .collection-cards--light .collection-cards__heading {
      font-size: 24px;
    }
  }

  .collection-cards__header--center {
    position: relative;
    justify-content: center;
    text-align: center;
  }

  .collection-cards__header--center .collection-cards__nav {
    position: absolute;
    inset-inline-end: 10px;
  }

  /* Every column is as tall as the tallest one, so the white review cards end on one line. */
  .collection-cards__item {
    display: flex;
    flex-direction: column;
  }

  .collection-cards__quote {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 14px;
    margin: 36px 0 0;
    padding: 32px 28px 28px;
    border: 1px solid #e3e7e7;
    border-radius: 4px;
    background: #fff;
    color: var(--deepest-brand-blue);
    text-align: start;
  }

  .collection-cards__titles {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .collection-cards__subheading,
  .collection-cards__footnote {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: white;
  }

  /* closer to the review cards: the card row keeps 50 px below it for the flip, so the line moves up into that space */
  .collection-cards__subheading {
    margin-block-start: 6px;
  }

  /* room below the line before the next section (was 8 px) */
  .collection-cards__footnote {
    max-width: 640px;
    margin: -22px auto 0;
    padding: 0 16px 64px;
    text-align: center;

    @media screen and (max-width: 749px) {
      padding-block-end: 40px;
    }

    @media screen and (max-width: 749px) {
      margin-block-start: -6px; /* phones keep only 30 px below the cards */
    }
  }

  /* Eagle & Ash, Oct 2026: light grey version (Anu: the dark section feels heavy). The card backs keep their own colours. */
  .section-collection-cards:has(.collection-cards--light),
  .collection-cards--light {
    background-color: #f4f3f1;
  }

  .collection-cards--blue,
  .section-collection-cards:has(.collection-cards--blue) {
    background-color: var(--soaring-brand-blue);
  }

  /* Eagle & Ash, 28 Oct 2026 (Anu chose option B in Claude Design): the review sits close under its card with a small pointer,
     and the columns are further apart on computers, so each review reads as part of its buyer type (was 36 px under, 14 px apart) */
  .collection-cards--bubble {
    @media screen and (min-width: 750px) {
      --cc-gap: 32px;
    }
  }

  .collection-cards--bubble .collection-cards__quote {
    position: relative;
    margin-block-start: 18px;
    border-radius: 6px;
  }

  .collection-cards--bubble .collection-cards__quote::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 50%;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-top: 1px solid #e3e7e7;
    border-left: 1px solid #e3e7e7;
    background: #fff;
    transform: rotate(45deg);
  }

  /* Eagle & Ash, 28 Oct 2026: card backs in the brand dark blue instead of the brown texture (homepage draft; Wholesale keeps brown) */
  .collection-cards--back-blue .collection-cards__back-body {
    background-color: var(--deepest-brand-blue);
    background-image: none;
  }

  .collection-cards--light .collection-cards__heading,
  .collection-cards--light .collection-cards__title,
  .collection-cards--light .collection-cards__subheading,
  .collection-cards--light .collection-cards__footnote {
    color: var(--deepest-brand-blue);
  }

  .collection-cards--light .collection-cards__nav-btn {
    border-color: var(--deepest-brand-blue);
    color: var(--deepest-brand-blue);
  }

  .collection-cards--light .collection-cards__nav-btn:hover {
    background-color: rgb(7 39 45 / 0.08);
  }

  .collection-cards--light .collection-cards__media {
    background-color: rgb(7 39 45 / 0.04);
  }

  .collection-cards__quote-mark {
    height: 0.45em;
    font-family: 'Lora', serif;
    font-size: 4rem;
    line-height: 0.6;
    color: #fd5000;
  }

  .collection-cards__quote-text {
    margin: 0;
    padding: 0;
    border: 0;
    font-family: 'Lora', serif;
    font-size: 18px;
    font-style: italic;
    line-height: 1.5;
  }

  .collection-cards__quote-source {
    margin-top: auto;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .collection-cards__nav {
    position: relative;
    z-index: 100;
    top: 30px;
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    margin-inline-start: auto;

    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .collection-cards__nav.collection-cards__nav--hidden {
    display: none;
  }

  /* computers: cards start on the page-margin line (as the hero text and the product row), and the arrows are the same as
     in the product row: dark blue circles, white arrow, at the middle of the photos, half over the outer cards' edges
     (Anu, 29 Oct 2026). The script below sets --cc-arrow-top from the first photo. */
  @media screen and (min-width: 750px) {
    .collection-cards__embla {
      padding-inline: var(--page-margin);
    }

    .collection-cards__inner {
      position: relative;
    }

    .collection-cards__header--center {
      position: static;
    }

    .collection-cards__header--center .collection-cards__nav {
      position: absolute;
      top: var(--cc-arrow-top, 50%);
      inset-inline: 0;
      z-index: 5;
      justify-content: space-between;
      margin: 0;
      padding-inline: calc(var(--page-margin) - 22px);
      transform: translateY(-50%);
      pointer-events: none;
    }

    .collection-cards .collection-cards__nav .collection-cards__nav-btn {
      border: 0;
      background: #07272d;
      color: #fff;
      box-shadow: 0 2px 10px rgb(0 0 0 / 0.2);
      pointer-events: auto;
    }

    .collection-cards .collection-cards__nav .collection-cards__nav-btn:hover:not(:disabled) {
      background: #115e67;
    }

    .collection-cards .collection-cards__nav .collection-cards__nav-btn:disabled {
      visibility: hidden;
    }
  }

  .collection-cards__nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid white;
    border-radius: 50%;
    background: transparent;
    color: white;
    cursor: pointer;
    transition: opacity 0.2s ease, background-color 0.2s ease;

    &:hover:not(:disabled) {
      background-color: rgba(255, 255, 255, 0.12);
    }

    &:focus-visible {
      outline: 2px solid white;
      outline-offset: 2px;
    }

    &:disabled {
      opacity: 0.35;
      cursor: default;
    }
  }

  .collection-cards__nav-icon {
    display: flex;
    width: 18px;
    height: 18px;

    & svg {
      width: 100%;
      height: 100%;
    }
  }

  .collection-cards__nav-icon--prev {
    transform: scaleX(-1);
  }

  /* Embla structural styles */
  .embla {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .collection-cards__viewport {
    overflow: hidden;
    padding-block: 50px;

    @media screen and (max-width: 749px) {
      padding-block: 30px;
    }
  }

  .collection-cards__container {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--cc-gap);
    margin: 0;
    padding: 0;
    touch-action: pan-y pinch-zoom;
  }

  .collection-cards__item {
    flex: 0 0 calc((100% - (var(--cc-per-view) - 1) * var(--cc-gap)) / var(--cc-per-view));
    min-width: 0;
  }

  .collection-cards__card {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    perspective: 1200px;
    -webkit-tap-highlight-color: transparent;
  }

  .collection-cards__card:focus-visible {
    outline: 2px solid white;
    outline-offset: 3px;
  }

  .collection-cards__flipper {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4.05;
    transform-style: preserve-3d;
    transition: transform 0.65s cubic-bezier(0.4, 0.2, 0.2, 1);
  }

  .collection-cards__card.is-flipped .collection-cards__flipper {
    transform: rotateY(180deg);
  }

  .collection-cards__face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
  }

  .collection-cards__flip-hint {
    position: absolute;
    inset-block-end: 14px;
    inset-inline-end: 14px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.94);
    color: #07272d;
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.18);
    pointer-events: none;
  }

  .collection-cards__card:hover .collection-cards__flip-hint {
    background: #fff;
  }

  .collection-cards__face--front {
    z-index: 1;
    gap: 22px; /* a little more room above the card title (Anu, 28 Oct 2026) */
  }

  .collection-cards__face--back {
    display: flex;
    flex-direction: column;
    color: white;
    transform: rotateY(180deg);
    z-index: 0;
  }

  .collection-cards__media {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.06);
  }

  .collection-cards__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .collection-cards__image--placeholder {
    background-color: var(--blue-spectrum-dark);
    fill: var(--blue-spectrum-light);
  }

  .collection-cards__card:hover:not(.is-flipped) .collection-cards__image {
    transform: scale(1.04);
  }

  /* Eagle & Ash, Oct 2026: centred, with room for two lines, so a long title does not make its photo shorter than the others */
  .collection-cards__title {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2lh;
    inset-inline-start: 14px;
    font-family: 'Lora', serif;
    font-weight: 400;
    /* 22 px (was 24): "The golfer who has everything," stays on one line with four cards in a row */
    font-size: 22px;
    line-height: 29px;
    text-align: center;
    color: white;

    @media screen and (max-width: 1300px) {
      font-size: 20px;
    }

    /* three cards and a bit in view with the page margin: the size follows the card width, so the longest line
       ("The golfer who has everything,") still fits on one line */
    @media screen and (min-width: 851px) and (max-width: 1099px) {
      font-size: calc((100vw - 148px) / 46) !important;
    }

    /* four cards in view (from 1100 px): at most 22 px */
    @media screen and (min-width: 1100px) {
      font-size: min(22px, calc((min(100vw, 1920px) - 176px) / 58.4)) !important;
    }

    @media screen and (max-width: 1200px) {
      font-size: 20px;
      line-height: 24px;
      inset-inline-start: 10px;
    }

    @media screen and (max-width: 749px) {
      font-size: 18px;
      line-height: 22px;
      inset-inline-start: 8px;
    }
  }

  .collection-cards__back-body {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 67px 45px 44px;
    background-color: var(--cc-back-brown);
    background-image: var(--cc-back-image);
    background-size: cover;
    background-position: center;
    overflow: auto;
    text-align: start;

    @media screen and (max-width: 1200px) {
      padding: 40px 20px 40px;
    }
  }

  .collection-cards__back-title {
    margin: 0;
    font-family: 'Lora', serif;
    font-weight: 500;
    font-size: 36px;
    line-height: 1.25;
    color: white;

    @media screen and (max-width: 1200px) {
      font-size: 28px;
    }

    @media screen and (max-width: 749px) {
      font-size: 20px;
    }
  }

  .collection-cards__back-text {
    margin: 0;
    margin-block-start: 40px;
    margin-block-end: 16px;
    font-family: 'Lora', serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.45;
    color: white;

    @media screen and (max-width: 1200px) {
      font-size: 14px;
      margin-block-start: 24px;
    }
  }

  .collection-cards__back-action {
    margin-block-start: auto;
    font-size: 16px;
  }

  .collection-cards__back-features {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 3.32px 25px;
    background-color: var(--deepest-brand-blue);

    @media screen and (max-width: 1200px) {
      padding-inline: 14px;
    }

    @media screen and (max-width: 749px) {
      padding-inline: 12px;
    }
  }

  .collection-cards__back-feature {
    display: flex;
    align-items: center;
    font-family: 'Lora', serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.4;
    color: white;

    @media screen and (max-width: 1200px) {
      font-size: 13px;
    }

    @media screen and (max-width: 749px) {
      font-size: 12px;
    }
  }

  .collection-cards__back-feature::after {
    content: '';
    margin-inline-start: 8px;
    width: 5px;
    height: 5px;
    background-color: white;
    border-radius: 50%;
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-cards__flipper,
    .collection-cards__image {
      transition: none;
    }
  }
{% endstylesheet %}

