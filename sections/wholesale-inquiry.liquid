{%- liquid
  assign title = section.settings.title
  assign description_top = section.settings.description_top
  assign description_bottom = section.settings.description_bottom
  assign form_id = section.id | prepend: 'ContactForm-'
-%}

<div class="wholesale-inquiry">
  <div class="wholesale-inquiry__inner">
    <div class="wholesale-inquiry__left">
      {%- if title != blank -%}
        <h2 class="wholesale-inquiry__title">{{ title | escape }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="wholesale-inquiry__features" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              <li class="wholesale-inquiry__feature" {{ block.shopify_attributes }}>
                <span class="wholesale-inquiry__feature-icon" aria-hidden="true">
                  {%- if block.settings.icon != blank -%}
                    {{
                      block.settings.icon | image_url: width: 73 | image_tag: loading: 'lazy', widths: '73, 146', sizes: '73px', class: 'wholesale-inquiry__feature-image'
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'wholesale-inquiry__feature-image wholesale-inquiry__feature-image--placeholder' }}
                  {%- endif -%}
                </span>

                {%- if block.settings.title != blank -%}
                  <span class="wholesale-inquiry__feature-title">{{ block.settings.title | escape }}</span>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="wholesale-inquiry__middle">
      {%- if description_top != blank -%}
        <div class="wholesale-inquiry__description wholesale-inquiry__description--top">
          {{ description_top }}
        </div>
      {%- endif -%}

      {%- if description_bottom != blank -%}
        <div class="wholesale-inquiry__description wholesale-inquiry__description--bottom">
          {{ description_bottom }}
        </div>
      {%- endif -%}
    </div>

    <div class="wholesale-inquiry__right">
      {% render 'contact-form'
        , form_id: form_id
        , privacy_notice: section.settings.privacy_notice %}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-wholesale-inquiry {
    background-color: #ffffff;
  }

  .wholesale-inquiry {
    width: 100%;
    background-color: #ffffff;
  }

  .wholesale-inquiry__inner {
    display: grid;
    grid-template-columns: 490fr 288fr 325fr;
    column-gap: 7.87%;
    width: 100%;
    max-width: 1920px;
    margin-inline: auto;
    padding: 77px 60px 90px;


    @media screen and (max-width: 1300px) {
      column-gap: 5%;
      padding: 70px 40px;

    }

    @media screen and (max-width: 990px) {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    @media screen and (max-width: 749px) {
      padding: 60px 20px;
      gap: 38px;
    }
  }

  .wholesale-inquiry__left,
  .wholesale-inquiry__middle,
  .wholesale-inquiry__right {
    display: flex;
    flex-direction: column;

  }

  .wholesale-inquiry__title {
    margin: 0;
    font-family: 'Lora'
    , serif;
    font-weight: 500;
    font-size: 32px;
    line-height: 1.25;
    color: var(--deepest-brand-blue);
    text-align: center;

    @media screen and (max-width: 749px) {
      font-size: 24px;
    }
  }

  .wholesale-inquiry__features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px 8px;
    margin: 90px 0 0;
    padding: 0;
    list-style: none;

    @media screen and (max-width: 1200px) {
      margin: 70px 0 0;
    }
    
    @media screen and (max-width: 990px) {
      margin: 50px 0 0;
    }

    @media screen and (max-width: 600px) {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px 8px;
    }
  }

  .wholesale-inquiry__feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 25px;
    min-width: 0;

    @media screen and (max-width: 1200px) {
      gap: 16px;
    }
  }

  .wholesale-inquiry__feature-icon {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 73px;
    height: 73px;
    min-width: 73px;
    min-height: 73px;

    @media screen and (max-width: 1200px) {
      width: 60px;
      height: 60px;
      min-width: 60px;
      min-height: 60px;
    }

    @media screen and (max-width: 749px) {
      width: 50px;
      height: 50px;
      min-width: 50px;
      min-height: 50px;
    }
  }

  .wholesale-inquiry__feature-image {
    display: block;
    width: 73px;
    height: 73px;
    max-width: none;
    object-fit: contain;

    @media screen and (max-width: 1200px) {
      width: 60px;
      height: 60px;
    }

    @media screen and (max-width: 749px) {
      width: 50px;
      height: 50px;
    }
  }

  .wholesale-inquiry__feature-image--placeholder {
    width: 73px;
    height: 73px;
    fill: #3D301D;
    border-radius: 50%;
    border: 1px solid #3D301D;
  }

  .wholesale-inquiry__feature-title {
    font-family: 'Lora'
    , serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.3;
    color: #000000;
    text-align: center;
  }

  .wholesale-inquiry__description {
    margin: 0;
    font-family: 'Roboto'
    , sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.25;
    color: var(--deepest-brand-blue);

    & a {
      text-decoration: none;
    }
  }

  .wholesale-inquiry__description--bottom {
    margin-block-start: 50px;

    @media screen and (max-width: 990px) {
      margin-block-start: 40px;
    }
  }

  .wholesale-inquiry__right {
    margin-top: -30px;

    @media screen and (max-width: 990px) {
      margin-top: 0;
    }
  }

  .wholesale-inquiry__middle {
    margin-top: 10px;
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Wholesale Inquiry",
    "class": "section-wrapper section-wholesale-inquiry",
    "tag": "section",
    "max_blocks": 4,
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Section title",
        "default": "Looking for Something More Personal?"
      }, {
        "type": "richtext",
        "id": "description_top",
        "label": "Description top",
        "default": "<p>Whether you're building a retail assortment, sourcing tournament gifts or looking for a long-term wholesale partnership, we'd love to hear from you.</p>"
      }, {
        "type": "richtext",
        "id": "description_bottom",
        "label": "Description bottom",
        "default": "<p>Tell us a little about your business and what you're looking for — and we'll take it from there.</p>"
      }, {
        "type": "richtext",
        "id": "privacy_notice",
        "label": "Privacy notice",
        "info": "Shown under the send button. Use this to link to your Privacy Policy.",
        "default": "<p>We use the details you provide only to respond to your enquiry. See our <a href=\"/policies/privacy-policy\">Privacy Policy</a>.</p>"
      }
    ],
    "blocks": [
      {
        "type": "feature",
        "name": "Feature",
        "limit": 4,
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          }, {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Feature"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Wholesale Inquiry",
        "blocks": [
          {
            "type": "feature",
            "settings": {
              "title": "Events & Tournaments"
            }
          }, {
            "type": "feature",
            "settings": {
              "title": "Pro-shop"
            }
          }, {
            "type": "feature",
            "settings": {
              "title": "Corporate & Group gifting"
            }
          }, {
            "type": "feature",
            "settings": {
              "title": "Bespoke Options"
            }
          }
        ]
      }
    ]
  }
{% endschema %}