{% liquid
  assign primary_menu = section.settings.primary_menu
  if primary_menu == blank and linklists['footer'] != blank
    assign primary_menu = linklists['footer']
  endif

  assign secondary_menu = section.settings.secondary_menu
  if secondary_menu == blank and linklists['footer-menu-block-two'] != blank
    assign secondary_menu = linklists['footer-menu-block-two']
  endif

  assign footer_logo = section.settings.logo_image
  if footer_logo == blank and settings.logo != blank
    assign footer_logo = settings.logo
  endif

  # Anu, 30 Oct 2026: on the About page (template page.our-story) the slogan stands large, with her sentence, in the place
  # of the footer sign-up (that page has its own sign-up band), and the logo is the store logo without the slogan
  assign ea_about_footer = false
  if template.name == 'page' and template.suffix == 'our-story' and section.settings.about_motto_heading != blank
    assign ea_about_footer = true
    if settings.logo != blank
      assign footer_logo = settings.logo
    endif
  endif
%}

<div
  class="custom-footer-divider"
  aria-hidden="true"
  role="presentation"></div>
<div class="custom-footer">
  <div class="custom-footer__main">
    <div class="custom-footer__newsletter">
      {%- if ea_about_footer -%}
        <p class="custom-footer__motto">{%- render 'ea-accent-text', text: section.settings.about_motto_heading -%}</p>
        {%- if section.settings.about_motto_text != blank -%}
          <p class="custom-footer__motto-text">{{ section.settings.about_motto_text | escape }}</p>
        {%- endif -%}
      {%- else -%}
      {% if section.settings.newsletter_heading != blank %}
        <h2 class="custom-footer__newsletter-heading">{{ section.settings.newsletter_heading }}</h2>
      {% endif %}

      <div class="custom-footer__newsletter-form">
        {%- liquid
          assign klaviyo_submit_label = section.settings.klaviyo_submit_label
          if klaviyo_submit_label == blank
            assign klaviyo_submit_label = 'SEND'
          endif
        -%}
        {% render 'email-signup-klaviyo-form'
          , klaviyo_company_id: section.settings.klaviyo_company_id
          , klaviyo_list_id: section.settings.klaviyo_list_id
          , label: klaviyo_submit_label
          , custom_source: 'Eagle & Ash footer'
          , form_id: section.id
          , privacy_notice: section.settings.privacy_notice
          , show_interest: false
        %}
      </div>
      {%- endif -%}
    </div>

    <div class="custom-footer__brand">
      {% if footer_logo != blank %}
        <img
          class="custom-footer__logo-image"
          src="{{ footer_logo | image_url: width: 500 }}"
          width="{{ footer_logo.width }}"
          height="{{ footer_logo.height }}"
          alt="{{ footer_logo.alt | default: section.settings.logo_alt | default: shop.name | escape }}"
          loading="lazy">
      {% endif %}

      <div class="custom-footer__meta" aria-label="{{ section.settings.bottom_meta_label | escape }}">
        {% if section.settings.meta_part_one != blank %}
          <span class="custom-footer__meta-brand">{{ section.settings.meta_part_one }}</span>
        {% endif %}
        {% if section.settings.meta_part_two != blank %}
          <span>{{ section.settings.meta_part_two }}</span>
        {% endif %}
        {% if section.settings.meta_part_three != blank %}
          <div class="custom-footer__meta-richtext">{{ section.settings.meta_part_three }}</div>
        {% endif %}
      </div>

    </div>

    <div class="custom-footer__menus">
      <nav class="custom-footer__menu-column" aria-label="{{ section.settings.primary_menu_label | escape }}">
        {% if primary_menu != blank %}
          <ul class="custom-footer__menu-list" role="list">
            {% for link in primary_menu.links %}
              <li class="custom-footer__menu-item">
                <a href="{{ link.url }}" class="custom-footer__menu-link">
                  {{- link.title -}}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}

        <div class="custom-footer__contact">
          {% if section.settings.contact_email != blank %}
            <a class="custom-footer__email" href="mailto:{{ section.settings.contact_email | strip | escape }}">
              {{- section.settings.contact_email | escape -}}
            </a>
          {% endif %}

        </div>
      </nav>

      <nav class="custom-footer__menu-column" aria-label="{{ section.settings.secondary_menu_label | escape }}">
        {% if secondary_menu != blank or section.settings.show_cookie_settings %}
          <ul
            class="custom-footer__menu-list{% if section.settings.show_cookie_settings %} custom-footer__menu-list--cookie-reorder{% endif %}"
            role="list"
          >
            {% if secondary_menu != blank %}
              {% for link in secondary_menu.links %}
                <li class="custom-footer__menu-item">
                  <a href="{{ link.url }}" class="custom-footer__menu-link">
                    {{- link.title -}}
                  </a>
                </li>
              {% endfor %}
            {% endif %}
            {% if section.settings.show_cookie_settings and section.settings.cookie_settings_label != blank %}
              <li class="custom-footer__menu-item custom-footer__menu-item--cookie">
                <button
                  type="button"
                  class="custom-footer__menu-link"
                  data-cookie-settings
                >
                  {{- section.settings.cookie_settings_label | escape -}}
                </button>
              </li>
            {% endif %}
          </ul>
        {% endif %}
      </nav>
    </div>
    {%- comment -%} Eagle & Ash, Oct 2026: social icons in their own block with a "Follow us" label, so narrow
      screens can show them right after the email signup. Computers: under the menus, as before. {%- endcomment -%}
    <div class="custom-footer__follow">
      {%- if section.settings.follow_label != blank -%}
        <p class="custom-footer__follow-label">{{ section.settings.follow_label | escape }}</p>
      {%- endif -%}
        <ul
          class="custom-footer__social"
          role="list"
          aria-label="{{ section.settings.social_label | escape }}">
          {% for block in section.blocks %}
            {% if block.type == 'social_link' %}
              {% render 'password-footer-social-item'
                , title: block.settings.title
                , link: block.settings.link
                , icon: block.settings.icon
                , image_upload: block.settings.custom_icon
                , shopify_attributes: block.shopify_attributes
                , modifier_class: 'custom-footer__social-item'
              %}
            {% endif %}
          {% endfor %}
        </ul>
    </div>
  </div>
</div>

{% if section.settings.show_cookie_settings %}
  <script>
    (function () {
      var section = document.querySelector('#shopify-section-{{ section.id }}');
      var button = section && section.querySelector('[data-cookie-settings]');
      if (!button) return;

      function showPreferences() {
        var banner = window.privacyBanner;
        if (!banner || typeof banner.showPreferences !== 'function') return false;
        try {
          banner.showPreferences();
        } catch (error) {
          return false;
        }
        return true;
      }

      button.addEventListener('click', function () {
        if (showPreferences()) return;
        if (!window.Shopify || typeof window.Shopify.loadFeatures !== 'function') return;

        window.Shopify.loadFeatures(
          [{ name: 'consent-tracking-api', version: '0.1' }],
          function (error) {
            if (error) return;
            showPreferences();
          }
        );
      });
    })();
  </script>
{% endif %}

{% stylesheet %}
  /* About page only: the slogan large, the sentence in Roboto (Anu, 30 Oct 2026) */
  .custom-footer .custom-footer__newsletter .custom-footer__motto {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 30px;
    line-height: 1.15;
    color: #fff;

    @media screen and (min-width: 990px) {
      font-size: 36px;
    }
  }

  .custom-footer__motto .ea-accent {
    display: block;
    color: #fd5000;
  }

  .custom-footer .custom-footer__newsletter .custom-footer__motto-text {
    max-width: 320px;
    margin: 14px 0 0;
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 1.55;
    color: #e3eef0;
  }

  .custom-footer-section {
    background-color: #ffffff;

  }

  .custom-footer-divider {
    height: 56px;
    background-color: var(--deepest-brand-blue);

    @media (max-width: 749px) {
      height: 28px;
    }
  }

  .custom-footer,
  .custom-footer__main {
    background-color: #ffffff;
  }

  .custom-footer {
    max-width: 1920px;
    margin-inline: auto;
    padding-top: 35px;
    padding-bottom: 10px;
    padding-inline: 40px;

    @media (max-width: 749px) {
      padding-inline: 20px;
    }
  }

  .custom-footer__newsletter-form {
    margin-block-start: 30px;

    & .email-signup-klaviyo__form-wrap {
      position: relative;
      gap: 0;
      padding: 0;
    }

    & .email-signup-klaviyo__message-text {
      color: #dfe9eb;
    }

    & .email-signup-klaviyo__message .icon-success {
      width: 24px;
      height: 24px;
    }

    & .email-signup-klaviyo__message svg {
      width: 24px;
      height: 24px;
    }

    & .email-signup-klaviyo__form {
      gap: 8px;
    }

    & .email-signup__fields {
      position: relative;
    }

    & .email-signup-klaviyo__form .email-signup-klaviyo__input {
      min-height: 26px;
      padding: 0 80px 0 0;
      font-size: 16px;
      color: var(--ash-amber-orange);
      border: none;
      border-bottom: 1px solid var(--ash-amber-orange) !important;

      &::placeholder {
        color: var(--ash-amber-orange);
      }
    }

    & .email-signup-klaviyo__button {
      position: absolute;
      right: 0;
      top: 0;
      min-height: 26px;
      padding: 0;
      font-size: 16px;
      background-color: transparent;
      border-bottom: 1px solid var(--ash-amber-orange);
      transition: color 0.3s ease;

      @media (max-width: 710px) {
        width: auto;
        margin-block-start: 0;
      }

       &:hover {
        background-color: transparent;
        color: var(--deepest-brand-blue);
      }
    }

    & .email-signup-klaviyo__interest-options {
      margin-block-start: 10px;
    }

    & .email-signup-klaviyo__interest-option input {
      width: 8px;
      height: 8px;
      border-color: var(--ash-amber-orange);
      border-width: 1px;
    }

    & .email-signup-klaviyo__interest-option label {
      font-size: 14px;
      line-height: 1.35;
      color: #000;
    }

     & .email-signup-klaviyo__interest-option:hover input {
      border-color: var(--ash-amber-orange);
    }

    & .email-signup-klaviyo__interest-option input::after {
      width: 8px;
      height: 8px;
      background-color: var(--ash-amber-orange);
    }

     & .email-signup-klaviyo__interest-option input:checked::after {
      background-color: var(--ash-amber-orange);
    }

    & .email-signup-klaviyo__interest-options {
      font-size: 12px;
      color: var(--ash-amber-orange);
    }

    & .email-signup-klaviyo__interest-option > span {
      opacity: 1;
    }

     & label:has(input[type=radio]) {
      gap: 5px;
    }

    & .email-signup-klaviyo__privacy {
      margin-block-start: 12px;
      color: var(--ash-amber-orange);
    }

    & .email-signup-klaviyo__privacy a:hover {
      color: var(--deepest-brand-blue);
    }
  }

  .custom-footer__main {
    display: grid;
    grid-template-columns: 325px 1fr 325px;
    align-items: start;
    gap: 36px;

    @media (max-width: 990px) {
      grid-template-columns: 1fr 1fr;
    }

    @media (max-width: 749px) {
      grid-template-columns: 1fr;
    }
  }

  .custom-footer__newsletter-heading {
    margin: 0;
    font-family: 'Lora'
    , serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    color: var(--ash-amber-orange);
  }

  .custom-footer__brand {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    gap: 32px;
    min-height: 100%;

    @media (max-width: 1200px) {
      gap: 8px;
    }

    @media (max-width: 990px) {
      grid-column: 1 / -1;
      grid-row: 1;
    }
  }

  .custom-footer__logo-image {
    display: block;
    width: 100%;
    height: auto;
    max-width: 240px; /* the logo file with the slogan (Anu, 30 Oct 2026): wide enough to read the slogan line */
  }


  .custom-footer__meta {
    display: flex;
    justify-content: center;
    text-align: center;
    gap: 24px;
    row-gap: 8px;
    font-family: 'Lora'
    , serif;
    font-size: 12px;
    font-weight: 400;
    color: var(--ash-amber-orange);

    @media (max-width: 1400px) {
      flex-direction: column;
    }
  }

  .custom-footer__meta-brand {
    font-weight: 600;
    text-transform: uppercase;
  }

  .custom-footer__meta-richtext {
    max-width: 320px;
    text-align: left;

    @media (max-width: 1400px) {
      max-width: 100%;
      text-align: center;
    }
  }

  .custom-footer__meta-richtext > :first-child {
    margin-block-start: 0;
  }

  .custom-footer__meta-richtext > :last-child {
    margin-block-end: 0;
  }

  .custom-footer__meta-richtext p {
    margin: 0;
  }

  .custom-footer__meta-richtext a {
    color: inherit;
  }

  .custom-footer__meta-richtext a {
    text-decoration: none;
  }

  .custom-footer__menus {
    display: grid;
    grid-template-columns: repeat(2, minmax(125px, 1fr));
    gap: 6px 24px;
  }

  .custom-footer__menu-list {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .custom-footer__menu-list--cookie-reorder > .custom-footer__menu-item:nth-child(1) {
    order: 1;
  }

  .custom-footer__menu-list--cookie-reorder > .custom-footer__menu-item:nth-child(2) {
    order: 2;
  }

  .custom-footer__menu-list--cookie-reorder > .custom-footer__menu-item--cookie {
    order: 3;
  }

  .custom-footer__menu-list--cookie-reorder > .custom-footer__menu-item:nth-child(n + 3):not(.custom-footer__menu-item--cookie) {
    order: 4;
  }

  .custom-footer__menu-item {
    margin: 0;
    line-height: 15px;
  }

  .custom-footer__menu-link {
    color: var(--ash-amber-orange);
    font-family: 'Lora'
    , serif;
    font-size: 12px;
    font-weight: 400;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .custom-footer__menu-link:hover,
  .custom-footer__email:hover {
    color: var(--deepest-brand-blue);
  }

  button.custom-footer__menu-link {
    display: inline;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
    appearance: none;
    text-align: inherit;
  }

  .custom-footer__contact {
    margin-block-start: 6px;
  }

  .custom-footer__email {
    font-size: 12px;
    font-weight: 400;
    font-family: 'Lora'
    , serif;
    color: var(--ash-amber-orange);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .custom-footer__social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: 0;
    margin-inline-start: -12px;
    padding: 0;
    list-style: none;
  }

  .custom-footer__social a {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    color: var(--ash-amber-orange);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .custom-footer__social a:hover {
    color: var(--deepest-brand-blue);
  }

  .custom-footer__social .password-footer__social-icon {
    display: block;
    width: 17px;
    height: 17px;
    fill: currentColor;
  }

  /* Eagle & Ash, Oct 2026: navy footer. Orange text on white measured 3.3:1 contrast (WCAG AA needs
     4.5:1 for small text). Light text on navy measures 12.7:1; the orange logo and hover colour on
     navy 4.8:1. Only colours change here; remove this block to return to the white footer. */
  .custom-footer-section,
  .custom-footer,
  .custom-footer__main {
    background-color: var(--deepest-brand-blue);
  }

  .custom-footer__newsletter-heading,
  .custom-footer__meta,
  .custom-footer__menu-link,
  .custom-footer__email,
  .custom-footer__social a,
  .custom-footer__newsletter-form .email-signup-klaviyo__privacy,
  .custom-footer__newsletter-form .email-signup-klaviyo__interest-options,
  .custom-footer__newsletter-form .email-signup-klaviyo__interest-option label,
  .custom-footer__newsletter-form .email-signup-klaviyo__button {
    color: #dfe9eb;
  }

  .custom-footer__newsletter-form .email-signup-klaviyo__form .email-signup-klaviyo__input {
    color: #dfe9eb;
    background-color: transparent;

    &::placeholder {
      color: rgb(223 233 235 / 0.75);
    }
  }

  .custom-footer__follow-label {
    margin: 0 0 4px;
    font-size: 12px;
    color: #dfe9eb;
    font-family: var(--font-body--family);
  }

  /* Computers: Follow us sits under the email signup (left column), as on phones. */
  @media screen and (min-width: 991px) {
    .custom-footer__newsletter { grid-column: 1; grid-row: 1; }
    .custom-footer__follow { grid-column: 1; grid-row: 2; }
    .custom-footer__brand { grid-column: 2; grid-row: 1 / span 2; }
    .custom-footer__menus { grid-column: 3; grid-row: 1 / span 2; }
  }

  /* Narrow screens, top to bottom: logo, email signup (heading, field, consent text), Follow us,
     menus, company address. The brand block is opened up so the logo and the address can take
     separate places. */
  @media screen and (max-width: 990px) {
    .custom-footer__brand {
      display: contents;
    }

    .custom-footer__logo-image {
      order: 1;
      grid-column: 1 / -1;
      justify-self: center;
    }

    .custom-footer__newsletter { order: 2; grid-column: 1 / -1; }
    .custom-footer__follow { order: 3; grid-column: 1 / -1; }
    .custom-footer__menus { order: 4; grid-column: 1 / -1; }

    .custom-footer__meta {
      order: 5;
      grid-column: 1 / -1;
    }
  }

  /* Body font (Roboto) for all footer text: easier to read at small sizes than the serif. */
  .custom-footer__newsletter-heading,
  .custom-footer__meta,
  .custom-footer__menu-link,
  .custom-footer__email,
  .custom-footer__newsletter-form .email-signup-klaviyo__privacy,
  .custom-footer__newsletter-form .email-signup-klaviyo__interest-options,
  .custom-footer__newsletter-form .email-signup-klaviyo__interest-option label,
  .custom-footer__newsletter-form .email-signup-klaviyo__form .email-signup-klaviyo__input,
  .custom-footer__newsletter-form .email-signup-klaviyo__form .email-signup-klaviyo__button {
    font-family: var(--font-body--family);
  }

  /* Email field: stays navy with light text while typing and when the browser fills in a saved
     address (Chrome's autofill otherwise paints it light blue-white and hides the SEND button). */
  .custom-footer__newsletter-form .email-signup-klaviyo__form .email-signup-klaviyo__input:focus {
    background-color: transparent;
    color: #dfe9eb;
  }

  .custom-footer__newsletter-form .email-signup-klaviyo__form .email-signup-klaviyo__input:-webkit-autofill,
  .custom-footer__newsletter-form .email-signup-klaviyo__form .email-signup-klaviyo__input:-webkit-autofill:hover,
  .custom-footer__newsletter-form .email-signup-klaviyo__form .email-signup-klaviyo__input:-webkit-autofill:focus {
    -webkit-text-fill-color: #dfe9eb;
    -webkit-box-shadow: 0 0 0 1000px var(--deepest-brand-blue, #07272d) inset;
    box-shadow: 0 0 0 1000px var(--deepest-brand-blue, #07272d) inset;
    caret-color: #dfe9eb;
    transition: background-color 9999s ease-out 0s;
  }

  .custom-footer__newsletter-form .email-signup-klaviyo__form .email-signup-klaviyo__input:autofill {
    -webkit-text-fill-color: #dfe9eb;
    box-shadow: 0 0 0 1000px var(--deepest-brand-blue, #07272d) inset;
  }

  .custom-footer__newsletter-form .email-signup-klaviyo__button {
    position: absolute;
    z-index: 1;
  }

  .custom-footer .custom-footer__meta .custom-footer__meta-richtext a {
    color: #dfe9eb;
  }

  .custom-footer .custom-footer__meta .custom-footer__meta-richtext a:hover,
  .custom-footer__menu-link:hover,
  .custom-footer__email:hover,
  .custom-footer__social a:hover,
  .custom-footer__newsletter-form .email-signup-klaviyo__button:hover,
  .custom-footer__newsletter-form .email-signup-klaviyo__privacy a:hover {
    color: var(--ash-amber-orange);
  }

{% endstylesheet %}

{% schema %}
  {
    "name": "Custom footer",
    "class": "section-wrapper custom-footer-section",
    "tag": "footer",
    "enabled_on": {
      "groups": ["footer"]
    },
    "settings": [
      {
        "type": "header",
        "content": "Newsletter content"
      },
      {
        "type": "text",
        "id": "newsletter_heading",
        "label": "Heading",
        "default": "Be the first to discover new collections."
      },
      {
        "type": "header",
        "content": "t:content.klaviyo_setup"
      },
      {
        "type": "text",
        "id": "klaviyo_company_id",
        "label": "t:settings.klaviyo_company_id",
        "info": "t:info.klaviyo_company_id",
        "default": "RMHHKa"
      }, {
        "type": "text",
        "id": "klaviyo_list_id",
        "label": "t:settings.klaviyo_list_id",
        "info": "t:info.klaviyo_list_id",
        "default": "Rcmc4K"
      }, {
        "type": "text",
        "id": "klaviyo_submit_label",
        "label": "t:settings.label",
        "default": "SEND"
      }, {
        "type": "richtext",
        "id": "privacy_notice",
        "label": "Privacy notice",
        "info": "Shown under the send button. Use this to link to your Privacy Policy.",
        "default": "<p>Yes, email me news and launch updates. You can unsubscribe at any time. See our <a href=\"/policies/privacy-policy\">Privacy Policy</a>.</p>"
      }, {
        "type": "header",
        "content": "Brand content"
      }, {
        "type": "image_picker",
        "id": "logo_image",
        "label": "Logo image"
      }, {
        "type": "text",
        "id": "logo_alt",
        "label": "Logo alt text",
        "default": "Eagle & Ash"
      }, {
        "type": "header",
        "content": "Menus"
      }, {
        "type": "link_list",
        "id": "primary_menu",
        "label": "Primary menu",
        "default": "footer"
      }, {
        "type": "text",
        "id": "primary_menu_label",
        "label": "Primary menu aria label",
        "default": "Footer links column one"
      }, {
        "type": "link_list",
        "id": "secondary_menu",
        "label": "Secondary menu"
      }, {
        "type": "text",
