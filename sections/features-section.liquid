{%- liquid
  assign heading = section.settings.heading
  assign has_icons = false
  for block in section.blocks
    if block.settings.icon != blank
      assign has_icons = true
    endif
  endfor
-%}

{%- comment -%} Eagle & Ash, Oct 2026: optional icon per item (solid navy PNGs, shown white on the dark bar), a light and a light-blue version. {%- endcomment -%}
<div class="features-section{% if section.settings.color_style == 'light' or section.settings.color_style == 'blue' %} features-section--light{% endif %}{% if section.settings.color_style == 'blue' %} features-section--blue{% endif %}{% if section.settings.color_style == 'teal' %} features-section--teal{% endif %}{% if has_icons %} features-section--icons{% endif %}">
  <div class="features-section__inner">
    {%- if heading != blank -%}
      <h2 class="visually-hidden">{{ heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="features-section__list" role="list">
        {%- for block in section.blocks -%}
          <li class="features-section__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon | image_url: width: 96 | image_tag: class: 'features-section__icon', alt: '', width: 34, height: 34, loading: 'lazy' }}
            {%- endif -%}
            <span class="features-section__label">{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .features-section {
    width: 100%;
    background-color: var(--deepest-brand-blue);
  }

  .features-section__inner {
    width: 100%;
    max-width: 1920px;
    margin-inline: auto;
    padding-inline: 116px;
    padding-block: 17px;

    @media screen and (max-width: 1200px) {
      padding-inline: 80px;
    }

    @media screen and (max-width: 950px) {
      padding-inline: 40px;
    }
  }

  .features-section__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;

    @media screen and (max-width: 990px) {
      gap: 16px;
      justify-content: center;
    }

    @media screen and (max-width: 749px) {
      flex-direction: column;
      gap: 12px;
    }
  }

  .features-section__item {
    display: flex;
    align-items: center;
  }

  .features-section__label {
    font-family: 'Lora', serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.4;
    color: white;
  }

  .features-section__item::after {
    content: '';
    margin-inline-start: 8px;
    width: 5px;
    height: 5px;
    background-color: white;
    border-radius: 50%;
  }

  /* Blue Spectrum Dark from the brand guidelines (PANTONE 5473 C), white text and icons (Anu, 29 Oct 2026) */
  .features-section--teal {
    background-color: #115e67;
  }

  .features-section--light {
    border-block: 1px solid rgb(0 30 38 / 0.12);
    background-color: #fff;
  }

  .features-section--blue {
    border-block: 0;
    background-color: var(--soaring-brand-blue);
  }

  .features-section--light .features-section__label {
    color: var(--deepest-brand-blue);
  }

  .features-section--icons .features-section__item {
    gap: 10px;
  }

  .features-section--icons .features-section__item::after {
    display: none;
  }

  .features-section__icon {
    flex: none;
    /* 34 px (was 28; Anu, 29 Oct 2026: "make the icons slightly bigger") */
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  /* the icons are navy; on the dark bar they are shown white */
  .features-section:not(.features-section--light) .features-section__icon {
    filter: brightness(0) invert(1);
  }

  /* phones: two columns, icon above the text */
  @media screen and (max-width: 749px) {
    .features-section--icons .features-section__list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px 12px;
    }

    .features-section--icons .features-section__item {
      flex-direction: column;
      gap: 6px;
      text-align: center;
    }

    .features-section--icons .features-section__label {
      font-size: 14px;
      line-height: 1.3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Features Section",
  "class": "section-wrapper section-features",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (visually hidden)",
      "default": "Product features"
    },
    {
      "type": "select",
      "id": "color_style",
      "label": "Colours",
      "options": [
        { "value": "dark", "label": "White on dark blue" },
        { "value": "light", "label": "Dark blue on white" },
        { "value": "blue", "label": "Dark blue on light blue" },
        { "value": "teal", "label": "White on Blue Spectrum Dark (#115E67)" }
      ],
      "default": "dark"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Feature"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Optional. A solid navy icon (Drive: Website - Icons / Web-ready); on the dark bar it is shown white."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features Section",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "text": "Timeless Design"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Crafted with Purpose"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Lasting Quality"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Made for Gifting"
          }
        }
      ]
    }
  ]
}
{% endschema %}
