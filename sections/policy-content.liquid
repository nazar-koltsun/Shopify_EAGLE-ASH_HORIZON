<div class="policy-content">
  <div class="policy-content__inner">
    {%- if page.title != blank -%}
      <h1 class="policy-content__title">{{ page.title | escape }}</h1>
    {%- endif -%}

    {%- if page.content != blank -%}
      <div class="policy-content__body">{{ page.content }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .section-policy-content {
    background-color: #ffffff;
  }

  .policy-content {
    width: 100%;
    background-color: #ffffff;
  }

  .policy-content__inner {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding: 60px 120px;

    @media screen and (max-width: 1300px) {
      padding: 80px 60px;
    }

    @media screen and (max-width: 749px) {
      padding: 60px 20px;
    }
  }

  .policy-content__title {
    margin: 0;
    font-family: 'Lora', serif;
    font-weight: 400;
    font-size: 32px;
    line-height: 1.25;  
    color: #000000;

    @media screen and (max-width: 749px) {
      font-size: 24px;
    }
  }

  .policy-content__body {
    margin-block-start: 58px;
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.6;
    color: #000000;

    @media screen and (max-width: 749px) {
      margin-block-start: 40px;
    }

    & > :first-child {
      margin-block-start: 0;
    }

    & > :last-child {
      margin-block-end: 0;
    }

    & h2,
    & h3,
    & h4,
    & h5,
    & h6 {
      margin: 0;
      margin-block-start: 1em;
      font-family: var(--font-body--family);
      font-weight: 700;
      line-height: 1.3;
      color: #000000;

    }

    /* Anu, 5 Nov 2026: section headings of the legal pages in Lora 22 px (the site's sub-heading size; were bold
       Roboto 16 px, the size of the text). Phones 20 px, below the 24 px page title. */
    & h2 {
      margin-block: 1.6em 0.5em;
      font-family: var(--font-heading--family);
      font-weight: 500;
      font-size: 22px;
      @media screen and (max-width: 749px) {
        font-size: 20px;
      }
    }

    & p {
      margin-block: 0 1em;
    }

    & ul,
    & ol {
      margin-block: 0 1em;
      padding-inline-start: 1.5em;
    }

    & ul.no-margin {
      margin-block: 0;
    }

    & ol.no-margin {
      margin-block: 0;
    }

    & li {
      margin-block-end: 0;

    }

    & li:last-child {
      margin-block-end: 0;
    }

    & strong,
    & b {
      font-weight: 600;
    }

    & a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }

    & p.no-margin {
      margin-block: 0;
    }
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Policy Content",
    "class": "section-wrapper section-policy-content",
    "tag": "section",
    "settings": [],
    "presets": [
      {
        "name": "Policy Content"
      }
    ]
  }
{% endschema %}
