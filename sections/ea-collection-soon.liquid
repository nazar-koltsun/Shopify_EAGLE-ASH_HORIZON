{%- comment -%}
  Eagle & Ash, 3 Nov 2026 (Anu: the printable-cards block should come before "Coming soon", or no one scrolls to it):
  the collection's "Coming soon" row as its own section, so other sections can sit between the products and this row.
  Same gifts and look as inside the product grid (snippets/ea-soon-items); switch "Coming soon" off in the
  products section of the same page.
{%- endcomment -%}
<div class="section section--page-width ea-soon-section spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
  <ul class="ea-soon-section__grid" role="list">
    {%- render 'ea-soon-items', collection: collection, heading: section.settings.heading -%}
  </ul>
</div>

{% stylesheet %}
  /* the same columns and gaps as the product grid of the gift collections: 4 x 264 px with 48/50 px gaps on computers,
     2 columns with 12 px gaps on phones */
  .ea-soon-section__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 50px 48px;
    margin: 0;
    padding: 0;

    @media screen and (max-width: 749px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }

  .ea-soon-section__grid:not(:has(.ea-soon-card)) {
    display: none;
  }

  .ea-soon-section .ea-soon-heading {
    margin-block-start: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Coming soon (own row)",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Coming soon" },
    { "type": "range", "id": "padding-block-start", "label": "Space above", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "Space below", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "Coming soon (own row)" }]
}
{% endschema %}
