{%- liquid
  assign title = section.settings.title
  assign image = section.settings.image
-%}

<div class="story-values">
  <div class="story-values__inner">
    <div class="story-values__items">
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
          {%- liquid
            assign item_number = forloop.index | prepend: '0' | slice: -2, 2
            if forloop.index > 9
              assign item_number = forloop.index
            endif
          -%}
          <article class="story-values__item" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h3 class="story-values__item-title">
                <span class="story-values__item-number">{{ item_number }}</span>
                {{ block.settings.title | escape }}
              </h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <div class="story-values__item-description">{{ block.settings.description }}</div>
            {%- endif -%}
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="story-values__aside">
      {%- if title != blank -%}
        <h2 class="story-values__title">{{ title | escape }}</h2>
      {%- endif -%}

      <div class="story-values__media">
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              widths: '480, 720, 960, 1200, 1400',
              sizes: '(max-width: 990px) 100vw, 42vw',
              class: 'story-values__image',
              alt: image.alt
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'story-values__image story-values__image--placeholder' }}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .section-story-values {
    background-color: #ffffff;
  }

  .story-values {
    width: 100%;
    background-color: #ffffff;
  }

  .story-values__inner {
    display: grid;
    grid-template-columns: 464fr 436fr;
    align-items: center;
    column-gap: 13.38%;
    width: 100%;
    max-width: 1920px;
    margin-inline: auto;
    padding: 120px 190px 150px 200px;


    @media screen and (max-width: 1300px) {
      padding: 100px 150px 100px 170px;
    }

    @media screen and (max-width: 990px) {
      padding: 70px 40px;
      column-gap: 20px;
    }

    @media screen and (max-width: 749px) {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 60px 20px;
    }
  }

  .story-values__items {
    display: flex;
    flex-direction: column;
    gap: 110px;
    margin-block-start: 50px;

    @media screen and (max-width: 1300px) {
      gap: 48px;
      margin-block-start: 0;
    }

    @media screen and (max-width: 990px) {
      gap: 40px;
    }

    @media screen and (max-width: 749px) {
      gap: 32px;
      order: 2;
    }
  }

  .story-values__item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .story-values__item-title {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-family: 'Lora', serif;
    font-weight: 400;
    font-size: 24px;
    line-height: 1.3;
    color: #000000;

    @media screen and (max-width: 1200px) {
      font-size: 22px;
    }

    @media screen and (max-width: 749px) {
      font-size: 20px;
      gap: 8px;
    }
  }

  .story-values__item-number {
    font-size: 48px;

    @media screen and (max-width: 1200px) {
      font-size: 36px;
    }

    @media screen and (max-width: 749px) {
      font-size: 28px;
    }
  }

  .story-values__item-description {
    margin: 0;
    font-family: 'Roboto', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.3;
    color: var(--deepest-brand-blue);

    & > :first-child {
      margin-block-start: 0;
    }

    & > :last-child {
      margin-block-end: 0;
    }

    & a {
      text-decoration: none;
    }
  }

  .story-values__aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 80px;


    @media screen and (max-width: 990px) {
      gap: 60px;
    }

    @media screen and (max-width: 749px) {
      gap: 32px;
      order: 1;
    }
  }

  .story-values__title {
    margin: 0;
    font-family: 'Lora', serif;
    font-weight: 500;
    font-size: 32px;
    line-height: 1.25;
    color: var(--deepest-brand-blue);
    text-align: center;
    white-space: pre-line;

    @media screen and (max-width: 990px) {
      font-size: 24px;
    }
  }

  .story-values__media {
    width: 100%;
    max-width: 560px;
    overflow: hidden;
    background-color: rgba(7, 39, 45, 0.06);

    @media screen and (max-width: 749px) {
      display: none;
    }
  }

  .story-values__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 436 / 545;
    object-fit: cover;
  }

  .story-values__image--placeholder {
    background-color: var(--blue-spectrum-dark, #07272d);
    fill: var(--blue-spectrum-light, #d9e2e3);
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Story Values",
    "class": "section-wrapper section-story-values",
    "tag": "section",
    "max_blocks": 3,
    "settings": [
      {
        "type": "textarea",
        "id": "title",
        "label": "Section title",
        "default": "Born from fire.\nMade to fly."
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Section image"
      }
    ],
    "blocks": [
      {
        "type": "item",
        "name": "Item",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Item title"
          },
          {
            "type": "richtext",
            "id": "description",
            "label": "Description",
            "default": "<p>Item description</p>"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Story Values",
        "blocks": [
          {
            "type": "item",
            "settings": {
              "title": "Forged by Experience.",
              "description": "<p>The best things are rarely created overnight. They're shaped through challenges, setbacks, quiet persistence and countless small decisions. We believe the objects we keep should carry that same sense of meaning.</p>"
            }
          },
          {
            "type": "item",
            "settings": {
              "title": "Crafted with Intention.",
              "description": "<p>At Eagle & Ash, every piece begins with intention. From premium materials to thoughtful craftsmanship, every detail is considered—creating gifts and keepsakes people are proud to give and even prouder to keep.</p>"
            }
          },
          {
            "type": "item",
            "settings": {
              "title": "Made to Last.",
              "description": "<p>Fire doesn't only destroy. It transforms. It's where experience becomes wisdom, confidence is earned, and new beginnings take shape. That belief lives in everything we create.</p>"
            }
          }
        ]
      }
    ]
  }
{% endschema %}
