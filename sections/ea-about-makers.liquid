{%- doc -%}
  Eagle & Ash About page (Anu, 30 Oct 2026, canvas round 15): one light blue block about the makers: the title "Inside the
  workshops.", three workshop photos with numbered captions and a credit line, then "Who makes what." with one column per
  gift and the place, and a closing line. A large pale eagle mark sits behind the second part, as in the homepage
  "Why it's different" band. Block types: photo, maker.
{%- enddoc -%}
<div class="ea-about-makers">
  {%- render 'ea-eagle-mark', class: 'ea-about-makers__eagle' -%}
  <div class="ea-about-makers__inner">
    <h2 class="ea-about-section-title">{%- render 'ea-accent-text', text: section.settings.title -%}</h2>
    <div class="ea-about-makers__photos">
      {%- assign ea_n = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'photo' -%}
          {%- assign ea_n = ea_n | plus: 1 -%}
          <figure class="ea-about-makers__photo" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 400px, 100vw', widths: '600, 900, 1200', alt: block.settings.image.alt }}
            {%- endif -%}
            <figcaption>
              <span class="ea-about-makers__heading"><span class="ea-about-makers__num" aria-hidden="true">0{{ ea_n }}</span>{{ block.settings.heading | escape }}</span>
              {%- if block.settings.caption != blank -%}<span class="ea-about-makers__caption">{{ block.settings.caption | escape }}</span>{%- endif -%}
            </figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.credit != blank -%}<p class="ea-about-makers__credit">{{ section.settings.credit | escape }}</p>{%- endif -%}

    <h2 class="ea-about-section-title ea-about-makers__who-title">{%- render 'ea-accent-text', text: section.settings.who_title -%}</h2>
    <ul class="ea-about-makers__who" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'maker' -%}
          <li {{ block.shopify_attributes }}>
            <h3>{{ block.settings.name | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
            <p class="ea-about-makers__place">{{ block.settings.place | escape }}</p>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if section.settings.note != blank -%}<p class="ea-about-makers__note">{{ section.settings.note | escape }}</p>{%- endif -%}
  </div>
</div>

{% stylesheet %}
  .ea-about-makers {
    position: relative;
    overflow: hidden;
    background: #d5ebee;
  }

  /* large and pale, cut off at the sides; its point rests on the bottom edge of the block, on the teal strip below
     (Anu, 30 Oct 2026, as on the homepage "Why it's different" band). The point is at 49.37 % of the mark's width. */
  .ea-about-makers__eagle {
    position: absolute;
    width: 1600px;
    max-width: none;
    height: auto;
    left: calc(62% - 790px);
    bottom: 0;
    color: #e4f1f3;
    pointer-events: none;
  }

  .ea-about-makers__inner {
    position: relative;
    max-width: 1312px;
    margin: 0 auto;
    padding: 48px 16px 48px;
  }

  .ea-about-makers__photos {
    display: grid;
    gap: 28px;
  }

  .ea-about-makers__photo { margin: 0; }

  .ea-about-makers__photo img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 4px;
  }

  .ea-about-makers__photo figcaption { margin-top: 12px; }

  /* on the light blue, the brand orange has only 2.7:1 contrast; this darker orange has 3.3:1 (large text needs 3:1) */
  .ea-about-makers .ea-accent,
  .ea-about-makers .ea-about-makers__num { color: #e04800; }

  /* numbered titles as in "Our story" and on the homepage: number 28.8 px, title 21 px, on one text line */
  .ea-about-makers__heading {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 21px;
    line-height: 1.3;
    color: #07272d;
  }

  .ea-about-makers__num {
    flex: none;
    font-size: 28.8px;
    font-weight: 400;
    line-height: 1;
    color: #fe5000;
  }

  .ea-about-makers__caption {
    display: block;
    margin-top: 6px;
    font-size: 15px;
    line-height: 1.45;
    color: #3d5257;
  }

  .ea-about-makers__credit {
    margin: 22px 0 0;
    text-align: center;
    font-size: 14px;
    color: #3d5257;
  }

  .ea-about-makers .ea-about-makers__who-title { margin-top: 48px; }

  .ea-about-makers__who {
    margin: 0;
    padding: 24px 0 0;
    list-style: none;
    border-top: 1px solid #a9cbd1;
    display: grid;
    gap: 24px;
  }

  .ea-about-makers__who h3 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 21px;
    color: #07272d;
  }

  .ea-about-makers__who p {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.5;
    color: #16282d;
  }

  .ea-about-makers__who .ea-about-makers__place {
    font-weight: 600;
    color: #115e67;
  }

  .ea-about-makers__note {
    margin: 36px 0 0;
    text-align: center;
    font-family: var(--font-heading--family);
    font-style: italic;
    font-size: 19px;
    color: #07272d;
  }

  @media screen and (min-width: 750px) {
    .ea-about-makers__photos { grid-template-columns: repeat(3, 1fr); gap: 32px; }
    .ea-about-makers__photo img { aspect-ratio: auto; height: 380px; }
    .ea-about-makers__who { grid-template-columns: repeat(2, 1fr); gap: 32px; }
  }

  @media screen and (min-width: 990px) {
    .ea-about-makers__inner { padding: 72px 64px 64px; }
    .ea-about-makers__who { grid-template-columns: repeat(4, 1fr); }
    .ea-about-makers__eagle { width: 2400px; left: calc(62% - 1185px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "E&A About: makers",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "info": "Words between two stars are orange.", "default": "Inside the *workshops.*" },
    { "type": "textarea", "id": "credit", "label": "Line under the photos" },
    { "type": "text", "id": "who_title", "label": "Second title", "default": "Who makes *what.*" },
    { "type": "text", "id": "note", "label": "Closing line" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Workshop photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "heading", "label": "Caption" },
        { "type": "text", "id": "caption", "label": "Small line" }
      ]
    },
    {
      "type": "maker",
      "name": "Maker column",
      "settings": [
        { "type": "text", "id": "name", "label": "Gift" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "place", "label": "Place" }
      ]
    }
  ]
}
{% endschema %}
