  /* v6 (12 Nov 2026, Anu): banner edge to edge like the gift pages, brighter on the right; the eagle mark of the
     homepage "Why our gifts are different" behind the steps and the state finder, its point on the line where the
     first state starts; a short "Before you buy" link in every state panel */
  .ea-gc__hero { margin-inline: calc(50% - 50vw); }
  .ea-gc__hero::after { background: linear-gradient(to right, rgba(0,30,38,.8) 0%, rgba(0,30,38,.5) 42%, rgba(0,30,38,0) 78%); }
  .ea-gc__hero-text { margin-inline: max(16px, calc((100vw - 1200px) / 2)); padding-inline: 0; }
  .ea-gc__part--steps { position: relative; z-index: 1; }
  .ea-gc__band { position: relative; overflow-x: clip; overflow-y: visible; margin-inline: calc(50% - 50vw); padding-inline: max(16px, calc((100vw - 1200px) / 2)); padding-block-end: 8px; }
  .ea-gc__band > :not(.ea-gc__eagle) { position: relative; z-index: 1; }
  .ea-gc__eagle { position: absolute; left: 58%; bottom: 0; width: 900px; height: auto; max-width: none; translate: -49.37% 0; color: #edf6f8; pointer-events: none; z-index: 0; }
  @media screen and (min-width: 990px) { .ea-gc__eagle { width: 1700px; } }
  .ea-gc__band .ea-gc__jump a { background: #fff; box-shadow: inset 0 0 0 1px #d5ebee; }
  .ea-gc__band .ea-gc__jump a:hover { background: #d5ebee; }
