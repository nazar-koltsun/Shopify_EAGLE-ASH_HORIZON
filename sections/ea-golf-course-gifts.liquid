{% stylesheet %}
  /* sizes and fonts copied from ea-press (design rules 5 Nov 2026): H1 24/32, H2 24/28/30, H3 22, text Roboto */
  .ea-gc {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-block: 48px 72px;
    color: #001e26;
  }

  .ea-gc--states {
    padding-block-start: 56px;
  }

  .ea-gc--top {
    padding-block-end: 56px;
  }

  .ea-gc__head {
    max-width: 760px;
  }

  .ea-gc__title {
    margin: 0 0 20px;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
  }

  .ea-gc__intro,
  .ea-gc__lead {
    margin: 0 0 12px;
    font-size: 17px;
    line-height: 1.6;
    max-width: 760px;
  }

  .ea-gc__checked {
    margin: 0;
    font-size: 15px;
    color: #115e67;
  }

  .ea-gc__eyebrow {
    margin: 0 0 6px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #115e67;
  }

  .ea-gc__h2 {
    margin: 0 0 20px;
    font-size: 24px;
    line-height: 1.3;
  }

  .ea-gc__h3 {
    margin: 0 0 8px;
    font-size: 22px;
    line-height: 1.3;
  }

  .ea-gc .ea-accent {
    color: #fd5000;
  }

  .ea-gc p {
    font-family: var(--font-body--family);
  }

  /* three steps: orange 01-03 as the homepage "Why it's different" (snippets/ea-home-why) and the About page story
     (Anu, 9 Nov 2026: "orange 01, 02, 03 - keep the style as close to our website as possible") */
  .ea-gc__steps {
    display: grid;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ea-gc__step p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
  }

  .ea-gc__step-heading.ea-story__heading {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 16px;
    font-family: var(--font-heading--family);
    font-weight: 500;
    color: #07272d;
  }

  .ea-gc__step-heading .ea-story__number {
    font-size: 28.8px;
    line-height: 1;
  }

  .ea-gc__step-heading .ea-story__heading-text {
    font-size: 21px;
    line-height: 1.3;
  }

  /* text links in our darker orange, as on the press page and the homepage (#b83a00 passes WCAG AA on white) */
  .ea-gc__step a,
  .ea-gc__about a,
  .ea-gc__why a {
    color: #b83a00;
    text-underline-offset: 3px;
  }

  /* "How we chose": three short points on the light-blue band, as the site's other info blocks */
  .ea-gc__about {
    padding: 40px 20px;
    border-radius: 8px;
    background: #edf6f8;
  }

  .ea-gc__about .ea-gc__h2 {
    text-align: center;
  }

  .ea-gc__rules {
    display: grid;
    gap: 24px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .ea-gc__rule-title {
    margin: 0 0 8px;
    font-size: 22px;
    line-height: 1.3;
  }

  .ea-gc__rules p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
  }

  .ea-gc__about .ea-gc__credits {
    margin: 32px 0 0;
    text-align: center;
  }

  /* four photo cards */
  .ea-gc__cards {
    display: grid;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ea-gc__card p {
    margin: 0 0 8px;
    font-size: 16px;
    line-height: 1.55;
  }

  .ea-gc__card .ea-gc__sub {
    color: #115e67;
    font-size: 15px;
  }

  .ea-gc__photo {
    position: relative;
    display: block;
    margin-block-end: 16px;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 8px;
  }

  .ea-gc__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ea-gc__label {
    position: absolute;
    inset-block-start: 12px;
    inset-inline-start: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    background: #001e26;
    color: #fff;
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ea-gc__h3 a {
    color: inherit;
    text-decoration: none;
  }



  /* layout v4 (12 Nov 2026, Anu): photo hero with the state finder above the fold, compact step strip,
     before-you-buy after the famous courses, finder text + select left and state pills right */
  .ea-gc__hero { position: relative; display: grid; min-height: 460px; margin: 0 0 8px; border-radius: 6px; overflow: hidden; color: #fff; }
  .ea-gc__hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; max-width: none; }
  .ea-gc__hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,30,38,.86) 0%, rgba(0,30,38,.62) 55%, rgba(0,30,38,.25) 100%); }
  .ea-gc__hero-text { position: relative; z-index: 1; align-self: center; max-width: 640px; padding: 40px 24px; }
  .ea-gc__hero .ea-gc__title, .ea-gc__hero .ea-gc__intro, .ea-gc__hero .ea-gc__checked { color: #fff; }
  .ea-gc__hero .ea-gc__checked { opacity: .9; font-size: 14px; }
  .ea-gc__select--hero { margin: 24px 0 12px; font-weight: 700; }
  .ea-gc__select--hero select { border-color: #fff; min-width: 240px; }
  @media screen and (min-width: 750px) { .ea-gc__hero-text { padding: 56px 48px; } }
  .ea-gc__part--steps { padding-block: 24px 8px; }
  .ea-gc__steps--strip .ea-gc__step p { font-size: 15px; margin-top: 6px; }
  .ea-gc__visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ea-gc__before .ea-gc__h2 { margin-top: 0; }
  .ea-gc__finder { display: grid; gap: 20px; margin-bottom: 24px; }
  .ea-gc__finder .ea-gc__jump { margin: 0; align-content: start; }
  @media screen and (min-width: 990px) { .ea-gc__finder { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; } }

  /* round 3 (12 Nov 2026): before-you-buy box, state select */
  .ea-gc__before { margin-top: 32px; padding: 24px; background: #edf6f8; border-radius: 6px; }
  .ea-gc__before ul { margin: 12px 0; padding-inline-start: 20px; }
  .ea-gc__before li + li { margin-top: 4px; }
