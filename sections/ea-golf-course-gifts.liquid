  /* v7 (12 Nov 2026, Anu): banner straight under the menu (no white gap), photo name in the lower right corner,
     "Before you buy" right under the eagle, on a light blue band to the screen edges, before the state list */
  .ea-gc--top { padding-block-start: 0; }
  .ea-gc__photo-credit { position: absolute; right: max(16px, calc((100vw - 1200px) / 2)); bottom: 10px; z-index: 1; margin: 0; font-size: 12px; color: #fff; opacity: .9; }
  .ea-gc__before--band { margin-inline: calc(50% - 50vw); padding: 36px max(16px, calc((100vw - 1200px) / 2)) 32px; border-radius: 0; margin-block: 0 24px; }
  .ea-gc__before--band .ea-gc__h2 { margin: 0 0 12px; }

  /* v8 (12 Nov 2026, Anu): the eagle as big as on the homepage (2641 px wide there on computers, 1200 px on phones);
     the banner stays in front of the eagle's wing tips */
  .ea-gc__hero { z-index: 2; }
  .ea-gc__eagle { width: 1200px; }
  @media screen and (min-width: 750px) { .ea-gc__eagle { width: 1900px; } }
  @media screen and (min-width: 990px) { .ea-gc__eagle { width: 2641px; } }
  .ea-gc__words-intro { margin-bottom: 4px; }
  .ea-gc__words-intro + .ea-gc__words { margin-top: 0; }

  /* v9 (13 Nov 2026, Anu): banner bright like the homepage banner: a white layer on the left that fades out to the
     right (the photo stays bright), title in our dark blue #07272d with the orange key words. Phones: as on the
     homepage, the photo on top and the text below it on white. Steps 01-03 on a petrol band #115e67 (board B),
     numbers light orange #ffa36e for contrast on petrol; the eagle stays on white below. */
  .ea-gc__hero { color: #001e26; }
  .ea-gc__hero::after { background: linear-gradient(to right, rgba(255,255,255,.88) 0%, rgba(255,255,255,.72) 40%, rgba(255,255,255,0) 75%); }
  .ea-gc__hero .ea-gc__title { color: #07272d; }
