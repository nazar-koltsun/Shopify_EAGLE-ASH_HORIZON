{% javascript %}
  (() => {
    const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const today = new Date();
    const md = (m, d) => m * 100 + d;
    const now = md(today.getMonth() + 1, today.getDate());
    /* open: [[startMonth, startDay, endMonth, endDay], ...]; a range may run over New Year */
    const state = (kind, open) => {
      if (kind === 'all_year') return { cls: 'is-open', text: 'Open all year' };
      /* main: the course publishes its main season, not which days it opens outside it (9 Nov 2026) */
      if (kind === 'main' && open.length) {
        for (const [sm, sd, em, ed] of open) {
          const a = md(sm, sd), b = md(em, ed);
          if (a <= b ? now >= a && now <= b : now >= a || now <= b) return { cls: 'is-open', text: 'Open now (published dates ' + sd + ' ' + MONTHS[sm - 1] + ' to ' + ed + ' ' + MONTHS[em - 1] + ')' };
        }
        return { cls: '', text: 'Outside its published dates: ask the course which days it is open' };
      }
      if (kind !== 'seasonal' || !open.length) return { cls: '', text: '' };
      for (const [sm, sd, em, ed] of open) {
        const a = md(sm, sd), b = md(em, ed);
        if (a <= b ? now >= a && now <= b : now >= a || now <= b) return { cls: 'is-open', text: 'Open now (season ' + sd + ' ' + MONTHS[sm - 1] + ' to ' + ed + ' ' + MONTHS[em - 1] + ')' };
      }
      const starts = open.map(([sm, sd]) => md(sm, sd));
      const next = starts.filter((x) => x > now).sort((x, y) => x - y)[0] ?? Math.min(...starts);
      const m = Math.floor(next / 100), d = next % 100;
      return { cls: 'is-closed', text: 'Closed for the season, opens about ' + d + ' ' + MONTHS[m - 1] };
    };

    const markCards = (root) => {
      root.querySelectorAll('.ea-gc__status').forEach((el) => {
        if (el.dataset.done) return;
        const s = state(el.dataset.kind, JSON.parse(el.dataset.open || '[]'));
        if (!s.text) { el.remove(); return; } /* no published season: show nothing (Anu, 12 Nov) */
        el.textContent = s.text;
        if (s.cls) el.classList.add(s.cls);
        const dot = el.parentElement.querySelector('.ea-gc__num-dot');
        if (dot && s.cls) dot.classList.add(s.cls);
        el.dataset.done = '1';
      });
    };

    let maps;
    const loadMaps = (url) => (maps ??= fetch(url).then((r) => r.json()));
    const drawMap = (fig, data) => {
      if (!data || fig.querySelector('svg')) return;
      const fill = { 'is-open': '#115e67', 'is-closed': '#6f7d81', '': '#fff' };
      const dots = data.dots.map((d) => {
        const s = state(d.kind, d.open);
        const ink = s.cls ? '#fff' : '#001e26';
        return '<g><title>' + d.n + '. ' + d.name.replace(/</g, '&lt;') + ': ' + (s.text || 'open dates not published') + '</title>' +
          '<circle cx="' + d.x + '" cy="' + d.y + '" r="8" fill="' + fill[s.cls] + '" stroke="' + (s.cls ? '#fff' : '#6f7d81') + '" stroke-width="2"/>' +
          '<text x="' + d.x + '" y="' + d.y + '" fill="' + ink + '">' + d.n + '</text></g>';
      }).join('');
      const label = 'Map of ' + fig.dataset.state + ' with ' + data.dots.length + ' of the courses below marked by number';
      fig.insertAdjacentHTML('afterbegin', '<svg viewBox="' + data.vb + '" role="img" aria-label="' + label + '"><path class="ea-gc__land" d="' + data.d + '"/>' + dots + '</svg>');
    };

    const init = () => {
      /* the guide is two sections on the page (top part and states part); the states part has the maps */
      const root = document.querySelector('.ea-gc--states') || document.querySelector('.ea-gc');
      if (!root) return;
      document.querySelectorAll('.ea-gc').forEach(markCards);
      const url = root.dataset.maps;
      const openPanel = (det) => {
        const fig = det.querySelector('.ea-gc__map');
        if (fig && url) loadMaps(url).then((all) => drawMap(fig, all[fig.dataset.state]));
      };
      root.querySelectorAll('details.ea-gc__state').forEach((det) => {
        det.addEventListener('toggle', () => det.open && openPanel(det));
        if (det.open) openPanel(det);
      });
      /* a state link opens that state's panel */
      const fromHash = () => {
        const id = decodeURIComponent(location.hash.slice(1));
        const el = id.startsWith('state-') && document.getElementById(id);
        if (el && el.tagName === 'DETAILS') el.open = true;
      };
      document.querySelectorAll('[data-ea-gc-select]').forEach((sel) => sel.addEventListener('change', () => {
        if (sel.value) location.hash = sel.value;
      }));
      window.addEventListener('hashchange', fromHash);
      fromHash();
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Golf course gift guide",
  "tag": "section",
  "class": "ea-gc-section",
  "settings": [
    { "type": "select", "id": "part", "label": "Part of the guide", "options": [{ "value": "top", "label": "Top: title and 3 steps" }, { "value": "states", "label": "Famous courses, states, how we chose" }], "default": "top" },
    { "type": "text", "id": "heading", "label": "Page title", "default": "Give a *round of golf* they'll never forget." },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "A round at a famous course is a gift golfers talk about for years. Below is a top public course for every US state, plus easier choices nearby. For each course you see where to buy a gift card, how far ahead tee times open, and when the course closes for the season." },
    { "type": "text", "id": "checked", "label": "Date checked", "default": "Booking rules and seasons checked on 8 November 2026." },
    { "type": "text", "id": "unwrap_label", "label": "Step 3 link text", "default": "golf gift for him" },
    { "type": "text", "id": "unwrap_url", "label": "Step 3 link", "default": "/collections/golf-gifts-for-men" }
  ],
  "presets": [{ "name": "Golf course gift guide" }]
}
{% endschema %}
