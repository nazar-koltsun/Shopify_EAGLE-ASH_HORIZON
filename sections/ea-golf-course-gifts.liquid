    .ea-gc__photo-credit { position: static; grid-row: 2; justify-self: end; margin: 6px 16px 0; color: #4a5a5e; opacity: 1; text-shadow: none; }
    .ea-gc__hero-text { grid-row: 3; padding-block: 16px 32px; }
